{
  "name": "@access/ui",
  "version": "0.0.0",
  "description": "Access's web UI: the suiss/ui base components (base-suiss on Base UI, copied from the suiss/ui registry and owned here) and the Access components built on them (the Why? panel, the status ladder, the step-up ceremony and the agent, payment, support and SSO surfaces).",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-suiss/access.git",
    "directory": "web/packages/ui"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/access/index.ts",
    "./elements": "./src/access/elements.ts",
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome lint --error-on-warnings ."
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.24"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "cmdk": "catalog:",
    "cn": "0.5.2",
    "input-otp": "1.5.0",
    "qrcode-generator": "catalog:",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@access/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vitest": "catalog:"
  }
}
