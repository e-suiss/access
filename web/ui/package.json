{
  "name": "@suiss/access-ui",
  "version": "0.0.0",
  "description": "The suiss/ui components the Access web pages are built from: the aria-suiss style on React Aria, copied from the suiss/ui registry and owned here.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-suiss/access.git",
    "directory": "web/ui"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.24"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "input-otp": "1.5.0",
    "react-aria-components": "1.22.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.5"
  }
}
