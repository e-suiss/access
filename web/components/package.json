{
  "name": "@suiss/access-react",
  "version": "0.0.0",
  "description": "Access embedded components: the Why? panel, the status ladder and the step-up ceremony. Renderers only: they show Access data and hand Exercise requests back; they keep no copy and decide nothing.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-suiss/access.git",
    "directory": "web/components"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./elements": "./src/elements.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
