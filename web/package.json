{
  "name": "@access/web",
  "version": "0.0.0",
  "description": "The Access web pages: the hosted login, the account pages and the console, with the suiss/ui components and the embeddable Access components they share.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "lint": "turbo run lint",
