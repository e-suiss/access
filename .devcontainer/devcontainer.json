// Optional dev container (OP-69). The Rust toolchain and the `just`, `cargo-nextest`
// and `bacon` versions match CI. Start the local services with `just dev` on the host;
// from inside the container they are reachable at host.docker.internal.
{
  "name": "access",
  // rust:1.99.0-trixie (must match rust-toolchain.toml), pinned by digest.
  "image": "rust@sha256:6ff07edce8775d0f64be7aba9197229407301bddf2054d62c27b541a6238a181",
  "remoteUser": "root",
  "containerEnv": {
    "CARGO_TERM_COLOR": "always"
  },
  "postCreateCommand": "rustup show active-toolchain && cargo install --locked just@1.58.0 cargo-nextest@0.9.146 bacon@3.26.0",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"]
    }
  }
}
