  "query": "SELECT tenant_id, status, placement_id,\n                  (extract(epoch FROM created_at) * 1000)::bigint AS \"created_ms!\" FROM access.tenants\n            WHERE tenant_id > $1 AND ($2::uuid IS NULL OR tenant_id = $2)\n            ORDER BY tenant_id LIMIT $3",
