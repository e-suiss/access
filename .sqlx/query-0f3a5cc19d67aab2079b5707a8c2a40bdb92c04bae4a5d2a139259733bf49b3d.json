  "query": "SELECT tenant_id, environment_id, slug, issuer FROM access.environments\n            WHERE status = 'active'\n              AND ($1::text IS NULL OR slug = $1)\n              AND ($2::uuid IS NULL OR tenant_id = $2)\n              AND slug > coalesce($3, '')\n              AND ($4::uuid[] IS NULL OR environment_id = ANY($4))\n            ORDER BY slug LIMIT $5",
