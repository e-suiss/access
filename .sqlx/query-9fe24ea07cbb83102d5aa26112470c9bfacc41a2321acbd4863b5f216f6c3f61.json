  "query": "SELECT tenant_id, realm_id, slug, issuer FROM access.realms\n            WHERE status = 'active'\n              AND ($1::text IS NULL OR slug = $1)\n              AND ($2::uuid IS NULL OR tenant_id = $2)\n              AND slug > coalesce($3, '')\n              AND ($4::uuid[] IS NULL OR realm_id = ANY($4))\n            ORDER BY slug LIMIT $5",
