; Suiss discovery, version 1 (RFC 8610; OP-149 m.3).
; The deterministic CBOR (RFC 8949 §4.2.1) of `suiss-discovery` is the `discovery` byte string of
; Domain Metadata, which the Kernel keeps opaque (CR-58 m.3). The `endpoints` map is the same map
; the realm's /.well-known/suiss-configuration document carries. Only endpoints in service appear.

suiss-discovery = {
  v: 1,
  endpoints: suiss-endpoints,
}

suiss-endpoints = {
  ? adp: https-url,
  ? key_lookup: https-url,
  ? key_batch: https-url,
  ? eligibility: https-url,
  ? tenant_snapshot: https-url,
  ? auth_context: https-url,
  ? instances: https-url,
  ? pairing_challenges: https-url,
  ? pairing: https-url,
  ? platform_streams: https-url,
  ? subject_resolution: https-url,
  ? exercise: https-url,
  ? exercise_agency: https-url,
}

; An absolute https URL in printable ASCII. A path variable is an RFC 6570 level 1 template
; expression, for example {kid} in key_lookup, {tenant} in tenant_snapshot and {exercise} in exercise and exercise_agency.
https-url = tstr .regexp "https://[!-~]{1,2040}"
