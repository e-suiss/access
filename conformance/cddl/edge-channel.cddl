; Access edge channel, version 1 (RFC 8610; OP-155 m.3 (c), m.6 (e), (f), (h); IDP-26, IDI-11,
; P-ID-5). The shapes are those of `crates/internal-api/src/edge.rs`.
;
; The calls a protocol gateway (`access-gw-saml`, `access-gw-ldap`, `access-gw-radius`,
; `access-gw-kerberos`) makes to access-server, each `POST /edge/v1/<call>` on the public TLS
; listener with the operator's client CA. That route is internal and is not in any public
; OpenAPI document. The gateway's client certificate carries exactly one SAN URI
; `urn:suiss:access:gw:<kind>:<name>`; access-server looks the gateway up by (kind, name,
; certificate SHA-256) and needs one exact live match. That identity, never a body member, says
; which gateway calls. A gateway is not an issuer: it writes neither store, never calls ADP and
; holds no realm key. The realm issuer signs every Claim inside access-server.
;
; Each body is one deterministic CBOR map (RFC 8949 §4.2.1), `application/cbor`, at most
; 64 KiB; a map with an unknown member is refused. A refusal is an RFC 9457 problem, not a CBOR
; body: `edge-unauthenticated`, `edge-gateway-unknown`, `edge-call-unknown`, `edge-media-type`,
; `edge-too-large`, `edge-malformed`, `edge-call-not-served`, `edge-unavailable`, or a refusal
; code of the call.
;
; `session_attest` is declared and answers `edge-call-not-served` until its lane serves it (P2);
; its body below is the planned shape, which the serving lane may refine before it serves the
; call. `authenticate` and `directory_read` are served for LDAP gateways (OP-155 m.3 (n)); any
; other kind gets `edge-method`.

edge-request = hello-request / subject-lookup-request / issue-claim-request / audit-request /
  authenticate-request / session-attest-request / directory-read-request

edge-answer = hello-answer / subject-lookup-answer / issue-claim-answer / audit-answer /
  authenticate-answer / session-attest-answer / directory-read-answer

; The path segment after /edge/v1/.
edge-call = "hello" / "authenticate" / "issue_claim" / "subject_lookup" / "session_attest" /
  "directory_read" / "audit"

gateway-kind = "saml" / "ldap" / "kerberos" / "radius"

; `<kind>` is a gateway-kind; the name starts with a lower-case letter, at most 63 characters.
gateway-uri = tstr .regexp "urn:suiss:access:gw:[a-z]{4,8}:[a-z][a-z0-9-]{0,62}"

; The slug of the one realm the gateway serves; every call names it and it must be its own.
realm-slug = tstr .size (1..64)

; The identity plane's opaque subject id; never an e-mail address or a user name.
subject-id = bstr .size 16

; --- hello: who the gateway is ------------------------------------------------------------

hello-request = {}

hello-answer = {
  gateway: gateway-uri,
  realm: realm-slug,
}

; --- subject_lookup -----------------------------------------------------------------------

; The login identifier the protocol carried (user name or e-mail).
subject-lookup-request = {
  realm: realm-slug,
  identifier: tstr .size (1..256),
}

; An active subject, or none: a suspended or unknown identifier answers the same.
subject-lookup-answer = {
  ? subject: subject-id,
}

; --- issue_claim --------------------------------------------------------------------------

; The facts of one authentication the gateway made; the realm issuer signs the Claim. The
; method is the Kernel's name for the gateway kind's one method (ldap: "ldap-bind", kerberos:
; "kerberos", radius: "password"; saml authenticates nobody itself). The authentication is AAL1
; with no assurance flags, at most 5 minutes old (3 minutes skew).
issue-claim-request = {
  realm: realm-slug,
  subject: subject-id,
  method: tstr .size (1..32),
  auth_time: uint,                      ; milliseconds since the epoch
  ? evidence: bstr .size 32,            ; digest of the raw protocol evidence
}

; The Claim is queued for the realm issuer; a refusal is a problem answer.
issue-claim-answer = {
  queued: bool,
}

; --- audit --------------------------------------------------------------------------------

; Codes only, no body and no personal data (OP-47).
audit-request = {
  realm: realm-slug,
  event: audit-code-32,                 ; e.g. ldap.bind
  outcome: audit-code-16,               ; e.g. ok, refused
  ? subject: subject-id,
}

audit-answer = {
  recorded: bool,
}

audit-code-32 = tstr .regexp "[a-z][a-z0-9._]{0,31}"

audit-code-16 = tstr .regexp "[a-z][a-z0-9._]{0,15}"

; --- authenticate (LDAP) -----------------------------------------------------------------

; One LDAP bind (§10.6.3). `simple` carries an LDAP credential, as `dn=token` or under its
; holder's DN `uid=<uid>,ou=people,o=<realm>`; the primary password never binds. `external` is
; SASL EXTERNAL: the client certificate chain the gateway's TLS session verified, leaf first; the
; realm's certificate sign-in rules decide. There is no SCRAM and no DIGEST-MD5. `rotate` is
; RFC 3062 on the LDAP credential just presented: a new secret replaces it.
authenticate-request = simple-bind / external-bind

simple-bind = {
  realm: realm-slug,
  mechanism: "simple",
  name: tstr .size (1..512),
  secret: bstr .size (1..1024),         ; never logged, never kept by the gateway
  ? rotate: true,
}

external-bind = {
  realm: realm-slug,
  mechanism: "external",
  chain: [+ bstr .size (1..8192)],     ; at most 8
}

; An unknown name and a wrong secret answer the same: an empty map. `bind` is the opaque,
; MAC'd handle `directory_read` needs (8 hours, this gateway only); `dn` is what WhoAmI answers;
; `secret` is the new LDAP credential after a rotation, shown once.
authenticate-answer = {} / {
  subject: subject-id,
  bind: bstr .size (1..256),
  dn: tstr .size (1..1024),
  ? secret: bstr .size (1..1024),
}

; --- session_attest (P2, OP-155 m.3 (c), IDI-7) ------------------------------------------

; access-server binds the browser endpoints and keeps the cookies; it forwards each request to
; the SAML gateway with a one-use handle. The gateway asks for the pinned certificates of the
; entity its message names (`sp`), has the parser worker verify the message, then redeems the
; handle with the verified facts (`issue`). access-server decides and keeps the outcome in its
; own flow; a handle that names no open flow of the realm is refused with `edge-attest`. Only a
; `saml` gateway may call it.
session-attest-request = session-attest-sp / session-attest-issue

session-attest-sp = {
  op: "sp",
  realm: realm-slug,
  entity: tstr .size (1..1024),
}

session-attest-issue = {
  op: "issue",
  realm: realm-slug,
  handle: bstr .size 32,
  redirect_signed: bool,                ; a detached Redirect signature verified by the worker
  ? facts: bstr,                        ; parser-worker.cddl saml-facts, when a message was read
}

session-attest-answer = session-attest-sp-answer / session-attest-decided

session-attest-sp-answer = {
  found: bool,
  certs: [* bstr .size (1..8192)],      ; at most 8 pinned certificates
  requests_signed: bool,
}

session-attest-decided = {
  decided: true,
}

; --- directory_read (LDAP) ---------------------------------------------------------------

; One page of a search of the realm's read-only directory tree for a live bind (IDP-16): filter
; depth ≤ 16 and ≤ 255 nodes, results ≤ 5000, page ≤ 1000, 10 s. The filter travels in prefix
; order as a flat list of nodes, so its depth never becomes CBOR nesting; `and`/`or` name how many
; filters follow. `chain` is the in-chain rule 1.2.840.113556.1.4.1941; `undefined` is any other
; extensible match (RFC 4511 §4.5.1.7).
directory-read-request = {
  realm: realm-slug,
  bind: bstr .size (1..256),
  base: tstr .size (0..1024),
  scope: "base" / "one" / "sub",
  filter: [+ filter-node],             ; at most 255
  attributes: [* attribute-name / "*" / "+" / "1.1"],   ; at most 64
  ? types_only: true,
  size_limit: uint .le 5000,
  page_size: uint .le 1000,             ; at least 1
  ? cookie: bstr .size (1..256),        ; the HMAC'd cookie of the previous page, 10 minutes
}

filter-node = ["and", uint .le 255] / ["or", uint .le 255] / ["not"] /
  ["eq", attribute-name, attribute-value] / ["ge", attribute-name, attribute-value] /
  ["le", attribute-name, attribute-value] / ["approx", attribute-name, attribute-value] /
  ["present", attribute-name] /
  ["substr", attribute-name, attribute-value, [* attribute-value], attribute-value] /
  ["chain", attribute-name, attribute-value] / ["undefined"]

; At most 256 entries. An attribute may come in consecutive chunks of at most 256 values. This
; answer alone may reach 1 MiB.
directory-read-answer = {
  entries: [* directory-entry],         ; at most 256
  outcome: "done" / "size_limit" / "time_limit" / "no_such_object",
  ? cookie: bstr .size (1..256),        ; absent on the last page
}

directory-entry = {
  dn: tstr .size (1..1024),
  attributes: [* [attribute-name, [* attribute-value]]],
}

attribute-name = tstr .regexp "[A-Za-z0-9][A-Za-z0-9.-]{0,127}"

attribute-value = tstr .size (0..4096)
