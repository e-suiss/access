; Access edge channel, version 1 (RFC 8610; OP-155 m.3 (c), m.6 (e), (f), (h); IDP-26, IDI-11,
; P-ID-5). The shapes are those of `crates/internal-api/src/edge.rs`.
;
; The calls a protocol gateway (`access-gw-saml`, `access-gw-ldap`, `access-gw-radius`,
; `access-gw-kerberos`) makes to access-server, each `POST /edge/v1/<call>` on the public TLS
; listener with the operator's client CA. That route is internal and is not in any public
; OpenAPI document. The gateway's client certificate carries exactly one SAN URI
; `urn:suiss:access:gw:<kind>:<name>`; access-server looks the gateway up by (kind, name,
; certificate SHA-256) and needs one exact live match. That identity, never a body member, says
; which gateway calls. A gateway is not an issuer: it writes neither store, never calls ADP and
; holds no realm key. The realm issuer signs every Claim inside access-server.
;
; Each body is one deterministic CBOR map (RFC 8949 §4.2.1), `application/cbor`, at most
; 64 KiB; a map with an unknown member is refused. A refusal is an RFC 9457 problem, not a CBOR
; body: `edge-unauthenticated`, `edge-gateway-unknown`, `edge-call-unknown`, `edge-media-type`,
; `edge-too-large`, `edge-malformed`, `edge-call-not-served`, `edge-unavailable`, or a refusal
; code of the call.
;
; `authenticate`, `session_attest` and `directory_read` are declared and answer
; `edge-call-not-served` until their lanes serve them (P10, P2, P10); their bodies below are
; the planned shapes, which the serving lane may refine before it serves the call.

edge-request = hello-request / subject-lookup-request / issue-claim-request / audit-request /
  authenticate-request / session-attest-request / directory-read-request

edge-answer = hello-answer / subject-lookup-answer / issue-claim-answer / audit-answer /
  authenticate-answer / session-attest-answer / directory-read-answer

; The path segment after /edge/v1/.
edge-call = "hello" / "authenticate" / "issue_claim" / "subject_lookup" / "session_attest" /
  "directory_read" / "audit"

gateway-kind = "saml" / "ldap" / "kerberos" / "radius"

; `<kind>` is a gateway-kind; the name starts with a lower-case letter, at most 63 characters.
gateway-uri = tstr .regexp "urn:suiss:access:gw:[a-z]{4,8}:[a-z][a-z0-9-]{0,62}"

; The slug of the one realm the gateway serves; every call names it and it must be its own.
realm-slug = tstr .size (1..64)

; The identity plane's opaque subject id; never an e-mail address or a user name.
subject-id = bstr .size 16

; --- hello: who the gateway is ------------------------------------------------------------

hello-request = {}

hello-answer = {
  gateway: gateway-uri,
  realm: realm-slug,
}

; --- subject_lookup -----------------------------------------------------------------------

; The login identifier the protocol carried (user name or e-mail).
subject-lookup-request = {
  realm: realm-slug,
  identifier: tstr .size (1..256),
}

; An active subject, or none: a suspended or unknown identifier answers the same.
subject-lookup-answer = {
  ? subject: subject-id,
}

; --- issue_claim --------------------------------------------------------------------------

; The facts of one authentication the gateway made; the realm issuer signs the Claim. The
; method is the Kernel's name for the gateway kind's one method (ldap: "ldap-bind", kerberos:
; "kerberos", radius: "password"; saml authenticates nobody itself). The authentication is AAL1
; with no assurance flags, at most 5 minutes old (3 minutes skew).
issue-claim-request = {
  realm: realm-slug,
  subject: subject-id,
  method: tstr .size (1..32),
  auth_time: uint,                      ; milliseconds since the epoch
  ? evidence: bstr .size 32,            ; digest of the raw protocol evidence
}

; The Claim is queued for the realm issuer; a refusal is a problem answer.
issue-claim-answer = {
  queued: bool,
}

; --- audit --------------------------------------------------------------------------------

; Codes only, no body and no personal data (OP-47).
audit-request = {
  realm: realm-slug,
  event: audit-code-32,                 ; e.g. ldap.bind
  outcome: audit-code-16,               ; e.g. ok, refused
  ? subject: subject-id,
}

audit-answer = {
  recorded: bool,
}

audit-code-32 = tstr .regexp "[a-z][a-z0-9._]{0,31}"

audit-code-16 = tstr .regexp "[a-z][a-z0-9._]{0,15}"

; --- authenticate (planned, P10) ----------------------------------------------------------

; A legacy credential check (LDAP bind, RADIUS PAP). The answer never tells an unknown name
; from a wrong secret.
authenticate-request = {
  realm: realm-slug,
  app: tstr .size (1..256),
  name: tstr .size (1..512),            ; the bind DN, `dn=token` form or user name
  secret: bstr .size (1..1024),         ; secret: never logged, never stored by the gateway
}

authenticate-answer = {
  ? subject: subject-id,                ; present exactly when the credential checked out
}

; --- session_attest (planned, P2) ---------------------------------------------------------

; access-server binds the browser endpoints and keeps the cookies; it forwards a request to the
; gateway with an opaque one-use handle, which the gateway redeems here.
session-attest-request = {
  realm: realm-slug,
  handle: bstr .size 32,
}

session-attest-answer = {
  subject: subject-id,
  sid: bstr .size (16..64),             ; the session reference SLO names; never the session id
  auth_time: uint,
  aal: 1 / 2 / 3,
  expires_at: uint,                     ; SessionNotOnOrAfter never passes it
}

; --- directory_read (planned, P10) --------------------------------------------------------

; A read of the realm's directory tree for the read-only LDAP gateway (IDP-16): filter depth
; ≤ 16, results ≤ 5000, page ≤ 1000, 10 s.
directory-read-request = {
  realm: realm-slug,
  base: tstr .size (0..1024),
  scope: "base" / "one" / "sub",
  filter: ldap-filter,
  attributes: [* attribute-name],
  size_limit: uint .le 5000,
  page_size: uint .le 1000,
  ? cookie: bstr .size (1..256),        ; the HMAC'd paging cookie of the previous page
}

ldap-filter = ["and", [+ ldap-filter]] / ["or", [+ ldap-filter]] / ["not", ldap-filter] /
  ["eq", attribute-name, tstr] / ["ge", attribute-name, tstr] / ["le", attribute-name, tstr] /
  ["approx", attribute-name, tstr] / ["present", attribute-name] /
  ["substr", attribute-name, substr-parts]

substr-parts = {
  ? initial: tstr,
  any: [* tstr],
  ? final: tstr,
}

directory-read-answer = {
  entries: [* directory-entry],
  ? cookie: bstr .size (1..256),        ; absent on the last page
}

directory-entry = {
  dn: tstr .size (1..1024),
  attributes: {* attribute-name => [* attribute-value]},
}

attribute-name = tstr .regexp "[A-Za-z][A-Za-z0-9_.:-]{0,127}"

attribute-value = tstr .size (0..4096) / bstr .size (0..4096) / int / bool
