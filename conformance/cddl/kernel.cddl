; Access Kernel core data model (RFC 8610).
; Encoding: deterministic CBOR, RFC 8949 §4.2.1; no floats, no tags, no null (OP-106).
; Defaults are never written: a missing field is its default. Arrays that are sets are sorted
; by the bytes of each element's canonical encoding, without repeats.

; ---------------------------------------------------------------- primitives

digest = [hash-alg, bstr .size 32]
hash-alg = -16

; Digest contexts (OP-106 m.22, OP-117 m.1): digest = SHA-256(context ‖ 0x00 ‖ dCBOR(value)).
; Each new digest kind adds a row "access/<kind>/v1" when the feature that produces it is adopted.
;   intent-envelope                          "access/intent/v1"
;   record-envelope of Genesis (domain-id)   "access/genesis/v1"
;   meta-payload                             "access/meta/v1"
;   [domain-id, nonce] (ExerciseID)          "access/exercise/v1"
;   [origin, kind, seq] (object id)          "access/object/v1"
;   COSE_Sign1 AIS bytes as received         "access/ais/v1"
;   COSE_Sign1 Claim bytes as received       "access/claim/v1"
;   policy-content (RestrictionPolicy version) "access/policy/v1"
;   receipt (decision receipt payload)       "access/receipt/v1"
;   COSE_Sign1 PAP bytes as signed           "access/pap/v1"
;   pap-holder                               "access/holder/v1"
;   [class, claim body] (claim-body-binding) "access/claim-body/v1"
;   approval-act-statement (H(AAS))           "access/aas/v1"
;   offline report chain link                "access/report-chain/v1"
;   validity-contract (report contract)      "access/validity/v1"
;   COSE_Sign1 PAP presentation as received  "access/pap-presentation/v1"
; Hash prefixes (OP-106 m.12), raw SHA-256 without a context:
;   0x00 Merkle leaf   0x01 Merkle interior node   0x02 field commitment   0x03 body commitment

trusted-time = uint .size 8
time-window = [from: trusted-time, until: trusted-time]

id = bstr .size 16
domain-id = digest
party-ref = id
instance-ref = id
grant-id = id
policy-ref = id

ident = tstr .regexp "[a-z][a-z0-9_]{0,62}"
namespace = tstr .regexp "[a-z][a-z0-9_-]{0,62}(\\.[a-z][a-z0-9_-]{0,62}){0,7}"
unit = tstr .regexp "[a-z][a-z0-9_]{0,15}"
path-segment = tstr .size (1..128)

amount = int .size 8

; Consequence tier, CT0–CT3 (§13.7.2), as a text map key (OP-106 m.4, OP-122 m.1).
ct-key = "ct0" / "ct1" / "ct2" / "ct3"

; ---------------------------------------------------------------- references

action-ref = {
  namespace: namespace,
  name: ident,
  major: uint,
  schema: digest,
}

resource-ref = {
  namespace: namespace,
  path: [+ path-segment],
  incarnation: uint,
}

purpose-ref = { code: ident } / { work: digest } / { aim: digest }

; ---------------------------------------------------------------- selectors

resource-selector = { exact: resource-ref } / structural-selector

structural-selector = {
  namespace: namespace,
  ? prefix: [+ path-segment],
  ? type: ident,
  ? where: { + ident => equality-value },
}

subject-selector =
    { party: party-ref }
  / { pred: [+ conjunct] }
  / "public"
  / { foreign: { domain: domain-id, authority_class: ident } }

conjunct = { claim_class: ident, ? value: equality-value }

equality-value = tstr / bstr / int / bool

; ---------------------------------------------------------------- parameter bounds (nine closed types)

param-bound =
    { enum: [+ tstr] }
  / { eq: equality-value }
  / { range: { ? min: amount, ? max: amount, unit: unit } }
  / { count_max: uint }
  / { interval: time-window }
  / { resource: resource-selector }
  / { subject: subject-selector }
  / { purpose: [+ purpose-ref] }
  / { flag: bool }

param-value =
    { enum: tstr }
  / { eq: equality-value }
  / { amount: { value: amount, unit: unit } }
  / { count: uint }
  / { interval: time-window }
  / { resource: resource-ref }
  / { subject: party-ref }
  / { purpose: purpose-ref }
  / { flag: bool }

; ---------------------------------------------------------------- authority

action-set = {
  ? exact: [+ action-ref],
  ? prefix: [+ { namespace: namespace, catalog: digest }],
}

authority-set = {
  actions: action-set,
  resource: resource-selector,
  ? params: { + ident => param-bound },
  ? recipient: subject-selector,
  ? purpose: [+ purpose-ref],
}

while-condition =
    { instance_alive: instance-ref }
  / { claim_held: { class: ident, subject: subject-selector, acceptance: digest } }

budget-term = {
  dimension: "count" / { amount: unit },
  capacity: uint,
  window: "total" / { rolling_s: uint },
}

constraint-set = {
  validity: time-window,
  ? while: [+ while-condition],
  ? budget: [+ budget-term],
}

delegation-terms = {
  ? depth: uint .ge 1,
  ? downstream_holder_class: subject-selector,
}

requirement-term = {
  proof_kind: "claim" / "contribution" / "authentication" / "foreign_authority",
  class: ident,
  ? count: uint .ge 2,
  ? binding: "actor_instance" / "intent_digest" / "resource",
  ? freshness_ms: uint,
  ? independence: { distinct: "party" / "instance" / "issuer" },
  ? consumption: "single_use",
  ? source: subject-selector,
  ? assurance: assurance,
}

; The closed assurance dimensions of §10.1.6 (OP-118 m.3). For `synced` the lower level is the
; stronger one.
assurance-flag = "phishing_resistant" / "hardware_bound" / "non_custodial" / "uv"
               / "human_presence" / "app_controlled_factor" / "synced"
assurance = { + ( "aal" => 1..3 // "loa_eidas" => 1..3 // assurance-flag => 0..1 ) }

requirement-set = [* requirement-term]

canonical-authority = {
  authority: authority-set,
  constraints: constraint-set,
  delegation: delegation-terms,
  requirements: requirement-set,
}

; ---------------------------------------------------------------- intent

intent-envelope = {
  action: action-ref,
  resources: [+ resource-ref],
  ? params: { + ident => param-value },
  ? opaque: { + ident => digest },
  ? recipient: party-ref,
  ? purpose: purpose-ref,
  ? context: {
    ? work: digest,
    ? commitment: digest,
    ? step: digest,
    ? upstream_exercise: digest,
  },
  validity: time-window,
}

; ---------------------------------------------------------------- restriction and decision

restriction-outcome =
    "no_objection"
  / { deny: { policy: policy-ref, policy_version: digest, ? undisclosed: true } }
  / { require: [+ requirement-term] }

blocker-class =
    "no-covering-authority" / "outside-instance-limits" / "restricted"
  / "budget-exhausted" / "ended" / "capacity-mismatch" / "source-not-accepted"
  / "schema-not-accepted" / "nonce-closed" / "foreign-status-unavailable"

position = "instance" / { hop: uint } / "anchor" / "domain-policy" / "foreign" / "actor-side"

resolver = { grantor_of_hop: uint } / "root" / "restriction-owner" / "issuer"
         / "domain-admin" / "actor" / "actor-party" / "time"

remediation = "route-to-coordinator" / "refresh-claim" / "self-authenticate"
            / { wait_until: trusted-time } / "not-satisfiable-by-actor" / "new-request-required"

blocker = {
  class: blocker-class,
  ? subcode: tstr,
  position: position,
  resolver: resolver,
  remediation: remediation,
}

unmet-term = {
  term: requirement-term,
  missing: uint .ge 1,
  position: position,
  satisfiable_by_actor: bool,
}

; Separate version tracks (§9.17.2). A verifier accepts every version up to the one it
; implements (§9.17 compat k.5); a version the domain has not adopted has no effect there (k.2);
; one below the domain's min_versions is a downgrade (k.4). Profiles compare by name only (k.6).
; Action schemas are pinned by Acceptance, not ordered; connectivity profiles are named by the
; validity-contract profile.
spec-versions = {
  core: uint,
  meta_schema: uint,
  ? profiles: { + ident => uint },
  ? schemas: [+ digest],
}

decision = {
  outcome: "allow" / "deny" / "require_action",
  ? blockers: [+ blocker],
  ? unmet: [+ unmet-term],
  ? relied_on: [+ id],
  ? versions: spec-versions,
}

; ---------------------------------------------------------------- evaluation input (OP-111 m.1)

capacity = "own" / { for: party-ref }

budget-state = {
  window: "total" / { rolling_s: uint },
  remaining: uint,
  demand: uint,
  ? resets_at: trusted-time,
}

; A stored grant the reading layer did not understand covers nothing (OP-108 m.4, OP-118 m.2).
hop = {
  authority: canonical-authority,
  ? status: "revoked" / "lapsed",
  ? conditions_fail: true,
  ? budgets: [+ budget-state],
} / { not_understood: true }

basis = {
  hops: [+ hop],
  capacities: [+ capacity],
}

mandate = {
  authority: authority-set,
  ? requirements: [+ requirement-term],
}

policy-result = {
  policy: policy-ref,
  version: digest,
  outcome: restriction-outcome,
}

proof = {
  id: id,
  kind: "claim" / "contribution" / "authentication" / "foreign_authority",
  class: ident,
  position: uint,
  time: trusted-time,
  party: party-ref,
  instance: instance-ref,
  issuer: party-ref,
  ? bound_instance: instance-ref,
  ? bound_intent: digest,
  ? bound_resource: resource-ref,
  ? assurance: assurance,
  ? consumed: true,
}

catalog = {
  ? catalogs: [+ { catalog: digest, actions: [+ action-ref] }],
  ? reserved: [+ action-ref],
  ? purposes: [+ { purpose: purpose-ref, below: [+ purpose-ref] }],
}

evaluation-input = {
  mode: "commit" / "continue" / "check",
  intent: intent-envelope,
  intent_digest: digest,
  now: trusted-time,
  ? actor_instance: instance-ref,
  ; Derived from the actor Party's actor-kind (OP-149 m.8).
  ? actor_is_agent: true,
  ? mandate: mandate,
  capacity: capacity,
  bases: [* basis],
  ? restrictions: [+ policy-result],
  ? proofs: [+ proof],
  catalog: catalog,
}

; ---------------------------------------------------------------- validity contract (§9.12)

validity-contract = {
  issuing_exercise: digest,
  basis_ref: bstr,
  holder: digest,
  audience: [+ tstr],
  bounds: authority-set,
  profile: {
    class: "online" / "intermittent" / "offline" / "long-running",
    variant: "online-strict" / "bounded-staleness" / "revalidate-on-reconnect"
           / "checkpointed-offline" / "checkpoint-continuation",
    ; Connectivity profile track version (OP-120 m.8).
    version: uint,
    ? params: { + ident => uint },
  },
  horizon: trusted-time,
  ? max_staleness_ms: uint,
  ? freshness_sources: [+ tstr],
  ? revalidation: { ? every_uses: uint, ? on_reconnect: true, ? action_classes: [+ ident] },
  ? offline_slice: [+ { budget_term: digest, amount: uint, unit: unit / "count" }],
  ? local_requirements: requirement-set,
  verifier_profile_ref: digest,
  clock: { source_class: ident, skew_ms: uint },
  ? must_understand: [+ ident],
  ; OP-150 m.3 (a), (s): the projection's entry in a Token Status List.
  ? status: status-ref,
}

; ---------------------------------------------------------------- record envelope (§17.6.1, OP-106)

record-kind = "genesis" / "opening" / "decision" / "claim"

; `kind` is "genesis" exactly at pos 0. Genesis has no `domain` and no `prev`; every later record
; has both, `prev` being the leaf hash of the record before it (OP-106 m.10, m.11).
; `field_salt` has exactly the names of `fields`; each salt is fresh from the RNG port (m.15).
; FC(name) = SHA-256(0x02 ‖ salt ‖ dCBOR([name, value])).
record-envelope = {
  record-header,
  fields: { + ident => any },
  field_salt: { + ident => bstr .size 32 },
}

record-header = (
  ? domain: domain-id,
  pos: uint,
  kind: record-kind,
  recorded_at: trusted-time,
  ? prev: digest,
)

; field_root = RFC 9162 root over FC(name), ordered by the UTF-8 bytes of name (OP-106 m.13).
; Leaf hash = SHA-256(0x00 ‖ dCBOR(leaf-core)); the leaf of the record is at index `pos` of its
; domain log.
leaf-core = {
  record-header,
  field_root: bstr .size 32,
}

; A record with some fields withheld (§17.6.1 rule 1). Opened fields carry value and salt and their
; commitments are recomputed; withheld fields carry only FC(name) as a digest. A name is in at most
; one of `fields` and `withheld`, and at least one field is present. A withheld name only orders
; its commitment and is not authenticated. A record-envelope is a disclosure with nothing withheld.
record-disclosure = {
  record-header,
  ? fields: { + ident => any },
  ? field_salt: { + ident => bstr .size 32 },
  ? withheld: { + ident => digest },
}

; ---------------------------------------------------------------- key scope (CR-58, T20, TI-RT6)

cose-alg = -19 / -9 / -7 / -48 / -49 / -50

public-key = { ed25519: bstr .size 32 }
           / { p256: bstr .size 65 }
           / { ml_dsa: [cose-alg, bstr] }

; OP-149 m.6: an Instance key is Ed25519 (COSE -19) or P-256, the uncompressed SEC 1 point,
; signing with ESP256 (COSE -9). ML-DSA keys are operational and binding keys only.
instance-key = { ed25519: bstr .size 32 } / { p256: bstr .size 65 }

; RFC 7638 SHA-256 thumbprint of the key; the Kernel recomputes it (CR-55 m.4).
key-id = bstr .size 32

; Verification keys by kid and the algorithms the caller's metadata allows (OP-116 m.2).
key-set = {
  keys: { + key-id => public-key },
  allowed: [+ cose-alg],
}

key-usage = "receipt" / "pap" / "token" / "checkpoint" / "set" / "status-list" / "key-lookup"

operational-key = {
  kid: key-id,
  alg: cose-alg,
  key: public-key,
  valid_from: trusted-time,
  valid_until: trusted-time,
  usage: [+ key-usage],
}

; Payload of a COSE_Sign1 signed by a binding key, content type "application/access-key-excerpt+cbor".
key-excerpt = {
  domain: domain-id,
  key: operational-key,
}

binding-scope = "domain" / { provider: [+ domain-id] }

binding-key = {
  kid: key-id,
  alg: cose-alg,
  key: public-key,
  scope: binding-scope,
  ? superseded: { at: digest, cited: digest },
}

; Payload of a COSE_Sign1 signed by a binding key, content type "application/access-domain-metadata+cbor".
domain-metadata = {
  domain: domain-id,
  genesis: digest,
  issued_at: trusted-time,
  binding: [+ binding-key],
  algorithms: [+ cose-alg],
  operational_window_max_ms: uint .le 86400000,
  operational_keys: [* operational-key],
  min_versions: spec-versions,
  ; Versions the domain has adopted; a version above them has no effect there (OP-120 m.7).
  adopted: spec-versions,
  ; Horizon ceilings in milliseconds by CT; the verifier passes the effective ceiling (OP-118 m.4).
  ? caps: { ? horizon: { + ct-key => uint }, ? slice_max: { + unit => amount } },
  ; Absent is "classic". While ML-DSA is disabled, "both" and "pq" fail closed (OP-118 m.5).
  ? hybrid: "classic" / "both" / "pq",
  ? discovery: bstr,
}

; Result of verifyCoseSign1 in the bindings (OP-116 m.9).
cose-verified = {
  kid: key-id,
  payload: bstr,
}

; ---------------------------------------------------------------- decision record fields (L2-REC-1)

; The fields of a record of kind "decision". `effects` only with outcome "allow" (L2-REC-2); a
; key appears in at most one effect of a record. State fold: L2-REC-3.
decision-fields = {
  outcome: decision,
  state_basis: state-basis,
  ? consumption: consumption,
  ? effects: [+ state-effect],
  versions: spec-versions,
  nonce: bstr .size (1..64),
  intent: digest,
  ? proof_commit: [+ digest],
  ? artifacts: [+ digest],
  ? validity: validity-contract,
}

state-key = bstr .size (1..512)

state-basis = {
  at: uint,
  reads: [* [key: state-key, version: uint]],
}

consumption = {
  ? draws: [+ [key: state-key, amount: uint]],
  ? single_use: [+ state-key],
}

; [key] removes the key; the encoding has no null (L0-ENC-2)
state-effect = [key: state-key, ? value: any]


; ---------------------------------------------------------------- exercise and actor (OP-141)

; INV-4: every Exercise names one basis. A Grant's own basis is never "public".
exercise-basis = { anchor: id } / { holding: [grant: id, holder: party-ref, since: uint] } / { public: id }

; Payload of a COSE_Sign1 signed by the actor Instance's current key, content type
; "application/access-ais+cbor" (CR-55 m.10, OP-141 m.7).
actor-intent-statement = {
  domain: domain-id,
  nonce: bstr .size (16..64),
  intent: digest,
  mode: "commit" / "continue" / "check",
  pep: tstr .size (1..255),
  capacity: capacity,
  basis: exercise-basis,
  iat: trusted-time,
  ? exercise: digest,
}

; Payload of a COSE_Sign1 signed by an Instance of the issuer, content type
; "application/access-claim+cbor" (OP-141 m.19 (b)). ClaimID: the first 16 bytes of the digest
; of the COSE_Sign1 bytes under "access/claim/v1".
claim-statement = {
  domain: domain-id,
  issuer: party-ref,
  subject: party-ref,
  class: ident,
  ? value: equality-value,
  issued_at: trusted-time,
  validity: time-window,
  ? assurance: assurance,
  ? bound_intent: digest,
  ? bound_instance: instance-ref,
  ? bound_resource: resource-ref,
  ? supersedes: id,
}

; The fields of a record of kind "claim" (OP-141 m.19 (d)). Effects only on "claim" keys, and
; only when admitted (L2-REC-2).
claim-fields = {
  claim: digest,
  id: id,
  issuer: party-ref,
  subject: party-ref,
  class: ident,
  disposition: "admit" / "quarantine:source-not-accepted" / "quarantine:future",
  ? effects: [+ state-effect],
}

; The fields of a record of kind "opening" (OP-141 m.8).
opening-fields = {
  nonce: bstr .size (16..64),
  actor: instance-ref / "anonymous",
  basis: exercise-basis,
  capacity: capacity,
  intent: digest,
  ? ais: digest,
  ? proof_commit: [+ digest],
  ? exercise: digest,
}

; ---------------------------------------------------------------- approval act (E32, §9.14)

; The statement one user act approves (OP-149 m.9). It is a proof and never an intent envelope:
; `target` is the intent digest of the request it approves (act "contribution") or of the
; approver's own meta-Exercise (act "authority-act"). The challenge of the approver's single
; assertion commits to it, and an `authentication` Claim binds its digest. Content type
; "application/access-aas+cbor".
approval-act-statement = contribution-act / authority-act

contribution-act = {
  act: "contribution",
  ; The `contribute` class the approval exercises, for example "approve" or "co_sign".
  contribution_class: ident,
  approval-act-fields,
}

authority-act = {
  act: "authority-act",
  approval-act-fields,
}

approval-act-fields = (
  approver: { instance: instance-ref, party: party-ref },
  capacity: capacity,
  target: digest,
  ; Stable before the ExerciseID exists: the nonce of the contribution Exercise, or of the
  ; approver's own meta-Exercise.
  exercise_ref: [domain: domain-id, nonce: bstr .size (16..64)],
  ; Present when a Work Gate waits on the approval: the Gate and the Work Declaration content.
  ? work_gate: { gate: digest, declaration: digest },
  ; The Approval Surface conformance profile the approval was given on.
  surface: { profile: tstr .size (1..255), version: uint },
  ; Digest of the render shown to the approver, produced from the action schema's render.
  render_digest: digest,
  ; The material fields the render showed, sorted, without repeats.
  material_fields: [* ident],
  issued_at: trusted-time,
  expires_at: trusted-time,
)

; ---------------------------------------------------------------- authority objects (OP-141)

root-value = { sole: party-ref } / { joint: { parties: [2* party-ref], k: uint .ge 1 } }

anchor-scope = { resource: resource-selector } / { party: party-ref } / "domain"

grant-content = {
  basis: { anchor: id } / { holding: [grant: id, holder: party-ref, since: uint] },
  holder: subject-selector,
  authority: canonical-authority,
  ? agency: [+ capacity],
  ? named: named-pin,
}

; OP-141 m.32: a pinned named AuthoritySet version and the digest of its authority-set.
named-pin = { name: ident, version: uint, digest: digest }

mandate-envelope = {
  authority: authority-set,
  constraints: constraint-set,
  ? requirements: requirement-set,
  ? pin: [grant: id, holder: party-ref, since: uint],
}

; OP-143 m.13 (a): a foreign issuer is a foreign domain with its pinned binding keys; it goes
; with use "foreign-authority" and only with it. Each class of such an Acceptance is an action
; namespace of that domain.
acceptance-content = {
  issuer: party-ref / { foreign: foreign-issuer },
  use: "actor-binding" / "predicate-input" / "subject-selection" / "foreign-authority" / "schema-definition",
  classes: [+ ident],
  subject: subject-selector,
  ? anchor: id,
  ? assurance_floor: assurance,
  validity: time-window,
  ? ingest_until: trusted-time,
  ? issued_until: trusted-time,
  ? quota: { count: uint .ge 1, window_s: uint .ge 1 },
  ? spp: spp,
  ? pinned: pinned-issuer,
}

; OP-150: the carrier key set of an issuer identified by a pinned key set (§9.13): the `iss`
; and `aud` its JWS carriers (OIDC ID token, SET) name and the keys they verify under, each
; found by its RFC 7638 thumbprint as `kid`. Not with a foreign issuer. Rotation is an
; acceptance_amend; dropping keys narrows, any other change widens.
pinned-issuer = { iss: tstr, aud: tstr, keys: [+ public-key] }

foreign-issuer = { domain: domain-id, binding: [+ binding-key] }

; OP-141 m.35: a Schema Publication Package, carried by a schema-definition Acceptance whose
; issuer is its publisher.
spp = {
  publisher: party-ref,
  namespace: namespace,
  catalog_version: uint,
  actions: [+ action-schema],
  ? retirements: [+ action-ref],
  ? core_spec_min: uint,
}

action-schema = {
  name: ident,
  major: uint,
  effect_class: "none" / "reversible" / "irreversible",
  ? reserved: true,
  ? consumption_bearing: true,
  ? params: { + ident => "amount" / "int" / "text" / "bool" / "bytes" / "id" / "opaque" },
  ? resource_types: [+ ident],
  ? render: tstr,
}

; OP-141 m.27: Cedar source against Access's published schema; `requirements` resolves the
; `@require` references of its forbid policies.
policy-content = {
  schema: "access/restriction/v1",
  source: tstr,
  target: "domain" / { anchor: id } / { party: party-ref } / { instance: instance-ref },
  ? requirements: { + tstr .size (1..255) => requirement-set },
}

; Disposition of the Grants that depend on an Anchor or a Party at transfer, retire or departure.
; There is no default (C10, E6).
disposition = [* [grant: id, "keep" / "revoke"]]

; ---------------------------------------------------------------- meta-action payloads (OP-141 m.13)

; The body of a core meta-action; its digest under "access/meta/v1" is `intent.opaque.payload`.
meta-payload =
    { anchor_create: { scope: anchor-scope, root: root-value, ? root_terms: requirement-set } }
  / { anchor_transfer: { anchor: id, root: root-value, disposition: disposition } }
  / { anchor_amend: { anchor: id, ? root: root-value, ? root_terms: requirement-set } }
  / { anchor_retire: { anchor: id, disposition: disposition } }
  / { party_register: { party: party-ref, root: root-value, actor_kind: actor-kind } }
  / { party_depart: { party: party-ref, disposition: disposition } }
  / { instance_create: { party: party-ref, key: instance-key, ? mandate: mandate-envelope } }
  / { instance_rekey: { instance: instance-ref, key: instance-key } }
  / { instance_terminate: { instance: instance-ref } }
  / { instance_recover: { instance: instance-ref, key: instance-key } }
  / { mandate_bind: { instance: instance-ref, envelope: mandate-envelope } }
  / { mandate_rebind: { mandate: id, envelope: mandate-envelope } }
  / { mandate_revoke: { mandate: id } }
  / { grant_issue: grant-content }
  / { grant_amend: { grant: id, authority: canonical-authority, ? agency: [+ capacity], ? named: named-pin } }
  / { grant_revoke: { grant: id } }
  / { grant_renounce: { grant: id } }
  / { acceptance_establish: acceptance-content }
  / { acceptance_amend: { acceptance: id, content: acceptance-content } }
  / { acceptance_revoke: { acceptance: id } }
  / { policy_set: { ? policy: id, content: policy-content } }
  / { policy_retire: { policy: id } }
  / { claim_issue: { subject: party-ref, class: ident, value: equality-value, ? validity: time-window, ? bound_intent: digest, ? supersedes: id } }
  / { contribute: { target: digest, class: ident } }
  / { consumption_release: { exercise: digest, grounds: [+ id] } }
  / { authority_set_define: { name: ident, authority: authority-set } }
  / { projection_issue: { bounds: canonical-authority, audience: [+ tstr .size (1..255)], profile: projection-profile, ? max_staleness_ms: uint, ? offline_slice: slice-request } }

; OP-149 m.8: what kind of actor a Party is. `party_register` sets it and no action changes it;
; an evaluation's `actor_is_agent` is true exactly when the actor's Party is an "agent".
actor-kind = "human" / "agent" / "system" / "machine" / "organization"

; The connectivity profile a projection is issued for; the variant belongs to the class as in
; validity-contract (OP-143 m.7).
; OP-143 m.12: drawn in advance from every lineage budget term of the named dimension.
slice-request = {
  ? count: uint .ge 1,
  ? amounts: { + unit => uint .ge 1 },
}

projection-profile = {
  class: "online" / "intermittent" / "offline" / "long-running",
  variant: "online-strict" / "bounded-staleness" / "revalidate-on-reconnect"
         / "checkpointed-offline" / "checkpoint-continuation",
}

; ---------------------------------------------------------------- genesis (C4, §5.2, OP-141)

; The fields of the record at pos 0. Objects it creates take their ids from the DomainID
; (OP-141 m.6), which is the digest of this record, so a Genesis Grant names its Anchor by
; position: 0 is the meta-anchor, n is entry n − 1 of `anchors`. Public Grants on the
; meta-anchor are the bootstrap path, e.g. for party_register.
genesis-grant = {
  anchor: uint,
  holder: subject-selector,
  authority: canonical-authority,
  ? agency: [+ capacity],
}

genesis-fields = {
  meta_anchor: { root: root-value, ? root_terms: requirement-set },
  ? anchors: [+ { scope: anchor-scope, root: root-value, ? root_terms: requirement-set }],
  ? grants: [+ genesis-grant],
  ? acceptances: [+ acceptance-content],
  ? reserved: [+ action-ref],
  ? policy: { ? ct3_delay_s: uint },
  versions: spec-versions,
}

; ---------------------------------------------------------------- state values (OP-141 m.12)

; A state key is dCBOR([kind, id ...]); its value is the object's content and terminal status.
; Status that depends on time or on other objects is derived, never stored (C2).
ended = { at: uint, how: "revoked" / "renounced" / "retired" / "terminated" / "recovered" / "departed" }

anchor-state = { scope: anchor-scope, root: root-value, ? root_terms: requirement-set, since: uint, ? ended: ended }
grant-state = { content: grant-content, since: uint, revision: uint, ? ended: ended }
party-state = { anchor: id, actor_kind: actor-kind, since: uint, ? ended: ended }
instance-state = { party: party-ref, key: instance-key, since: uint, ? successor: instance-ref, ? ended: ended }
mandate-state = { instance: instance-ref, envelope: mandate-envelope, since: uint, ? ended: ended }
acceptance-state = { content: acceptance-content, since: uint, ? ended: ended }
policy-state = { content: policy-content, since: uint, ? ended: ended }
claim-state = {
  issuer: party-ref,
  subject: party-ref,
  class: ident,
  ? value: equality-value,
  ? validity: time-window,
  ? assurance: assurance,
  ? bound_intent: digest,
  ? bound_instance: instance-ref,
  ? bound_resource: resource-ref,
  ? issued_at: trusted-time,
  ? supersedes: id,
  ? instance: instance-ref,
  since: uint,
  ? ended: ended,
}
; OP-141 m.28: the budget counters an allowed Exercise drew from, sorted by key, and the
; Claims that grounded its releases; released <= drawn.
; OP-141 m.32: dCBOR(["authority_set", name]) holds the latest version, and
; dCBOR(["authority_set", name, version]) one version.
authority-set-state = { authority: authority-set, since: uint }
; OP-143 m.7: dCBOR(["projection", ExerciseID]); `bounds` is the digest of the payload's bounds
; under "access/bounds/v1" and `horizon` the end of their validity.
projection-state = { holder: instance-ref, basis: exercise-basis, bounds: digest, horizon: trusted-time, audience: [+ tstr .size (1..255)] }

exercise-draw = { key: bstr, drawn: uint, released: uint, ? unit: unit }
exercise-state = {
  intent: digest,
  actor: instance-ref,
  since: uint,
  ? draws: [+ exercise-draw],
  ? grounds: [+ id],
}
contribution-state = {
  target: digest,
  class: ident,
  party: party-ref,
  instance: instance-ref,
  since: uint,
  ? consumed: uint,
  ; H(AAS) of the statement the approver's act signed (§9.14.1, SI-5), and the assurance and
  ; auth_time of the `authentication` Claim bound to it (§13.7.3): what the contribution carries
  ; as a proof.
  ? statement: digest,
  ? assurance: assurance,
  ? auth_time: trusted-time,
}

; ---------------------------------------------------------------- decision receipt (L2-RCP-1)

; Payload of a COSE_Sign1 signed by an operational key with usage "receipt", content type
; "application/access-receipt+cbor".
receipt = {
  domain: domain-id,
  exercise: digest,
  record: uint,
  intent: digest,
  ? instance: id,
  ? ais: digest,
  capacity: capacity,
  basis: exercise-basis,
  audience: tstr .size (1..255),
  iat: trusted-time,
  drawn: bool,
  ? agency: [+ agency-link],
}

; OP-149 m.11: one link of the chain the actor acted on behalf of, in order from the principal
; to the agent; the agent of a link is the principal of the next one.
agency-link = {
  mandate: id,
  principal: party-ref,
  agent: party-ref,
}

; ---------------------------------------------------------------- Portable Authority Proof (L2-PAP-1)

; Payload of a COSE_Sign1 signed by an operational key with usage "pap", content type
; "application/access-pap+cbor". Audience, offline slice and must-understand items are the
; contract's (validity).
pap = {
  domain: domain-id,
  projection_exercise: digest,
  holder: pap-holder,
  capacity: capacity,
  bounds: authority-set,
  ? local_requirements: requirement-set,
  validity: validity-contract,
  lineage_commitment: digest,
  iat: trusted-time,
}

; The holder Instance and its key; validity.holder is the digest of this value under
; "access/holder/v1".
pap-holder = {
  instance: id,
  key: public-key,
}

; Payload of a COSE_Sign1 signed by the holder key, content type
; "application/access-pap-presentation+cbor" (proof of possession, §9.10 step 3).
pap-presentation = {
  pap: digest,
  intent: digest,
  audience: tstr .size (1..255),
  nonce: bstr .size (16..64),
  iat: trusted-time,
}

; ---------------------------------------------------------------- Approval Act Statement digest (L2-AAS-1)

; H(AAS) is the digest of the statement under "access/aas/v1". A WebAuthn assertion carries its
; 32 bytes as the challenge; an Instance key signs the statement itself as a COSE_Sign1 with
; content type "application/access-aas+cbor". Either way an `authentication` Claim names the
; digest in `statement`.

; ---------------------------------------------------------------- Claim bodies (OP-150 m.2, §9.13, §10.1.5)

; Class names on the wire are idents: "account.status" is "account_status", "party.key-state"
; is "party_key_state", "identity-binding.person" is "identity_binding_person" (OP-141 m.31).
; A class with one scalar field carries it in the Claim's `value`:
;   account_status           tstr: "active" / "locked" / "suspended" / "deactivated" / "tombstone"
;   party_compromise         uint: occurred_at; absent when unknown (OP-141 m.31)
;   party_terminated         uint: the time
;   party_identity_break     ident: the reason
;   controller_of            party-ref: the controller
;   operated_by              party-ref: the operator
;   sponsored_by             party-ref: the sponsor
;   agent_kind               ident: the kind of agent
; Every other Stage 6 class has a body: its `value` is the 32-byte digest of the
; claim-body-binding, and the body travels beside the Claim. A withheld body leaves a
; digest-valued Claim (E26).
claim-body-binding = [class: ident, body: claim-body]

claim-body = authentication / authenticator-binding / device-posture / verifier-profile
           / offline-exercise-report / authority-state-ack / party-key-state / party-recovered
           / identity-binding

auth-method = "webauthn" / "password" / "totp" / "device-key" / "oidc" / "saml" / "ldap-bind"
            / "kerberos" / "x509"

; Class "authentication" (§10.1.2, §10.1.5): subject the Party, `bound_instance` the Instance it
; authenticated, `assurance` the vector; a step-up bound to an intent names it in `bound_intent`.
authentication = {
  method: auth-method,
  auth_time: trusted-time,
  ; H(AAS) the assertion's challenge committed to (§9.14.1).
  ? statement: digest,
  ; Digest of the raw assertion; the assertion itself stays in the PII vault (§10.1.2 rule 1).
  ? evidence: digest,
  ? webauthn: { aaguid: bstr .size 16, sign_count: uint, ? up: true, ? uv: true, ? be: true, ? bs: true },
  ? upstream: { iss: tstr .size (1..2048), ? acr: tstr, ? amr: [+ tstr] },
}

; Class "authenticator_binding" (§10.1.3, IDP-2): subject the Party, `bound_instance` the
; Instance. `material` is the digest of public material only (the credential id and public key,
; or the device key); never a secret.
authenticator-binding = {
  kind: "passkey" / "device-key" / "password" / "totp" / "x509",
  material: digest,
  ? alg: int,
  ? attestation: { format: tstr .size (1..64), result: "verified" / "self" / "none" / "failed" },
  ? aaguid: bstr .size 16,
  ? be: true,
  ? transports: [+ tstr .size (1..32)],
}

; Class "posture_device" (§5.9, §7.9.12.2): subject the Party, `bound_instance` the Instance.
device-posture = {
  verdict: "compliant" / "noncompliant" / "unknown",
  source: tstr .size (1..255),
  observed_at: trusted-time,
  ? nonce: digest,
  ? evidence: digest,
}

; Class "verifier_profile" (§9.12.1): issuer the verifier's operator, subject the verifier's
; Party. A ValidityContract names this Claim's body digest in `verifier_profile_ref`.
verifier-profile = {
  verifier: { instance: instance-ref } / { workload: tstr .size (1..255) },
  ; The connectivity profiles it implements, by variant, with their parameter ceilings.
  profiles: { + profile-variant => { ? params: { + ident => uint } } },
  versions: spec-versions,
  clock: { source_class: ident, skew_ms: uint },
  ? tamper_evident_counter: true,
  ? offline_report: true,
  ; §9.10.1 step 8.
  ? content_position_check: true,
  ; Status and revocation sources it reaches.
  ? status_access: [+ tstr],
  ; How often it refreshes epochs and status; absent for a JWT-only RS (§9.11.2).
  ? refresh_interval_ms: uint,
  ? attestation: digest,
  ; Its local acceptance ceilings in milliseconds (cap_horizon, U25).
  ? cap_horizon: { + profile-variant => { + ct-key => uint } },
  ? slice_max: { + unit => amount },
  ; RS and PEP conformance declarations (§11.5.6).
  ? conformance: [+ tstr .size (1..255)],
}

profile-variant = "online-strict" / "bounded-staleness" / "revalidate-on-reconnect"
                / "checkpointed-offline" / "checkpoint-continuation"

; Class "offline_exercise_report" (§9.12.2): issuer the verifier, subject the projection
; holder's Party. Its chain (L2-RPT-2) runs across reports: `previous` is the head of the last
; report for the projection, `first_seq` the sequence number of the first entry.
offline-exercise-report = {
  verifier: { profile: digest, ? instance: instance-ref },
  projection: { exercise: digest, contract: digest },
  period: time-window,
  ? previous: digest,
  first_seq: uint,
  entries: [* report-entry],
  head: digest,
  ? slice_unused: [+ { budget_term: digest, amount: uint }],
  profile_version: uint,
}

report-entry = {
  intent: digest,
  ? params: digest,
  time: trusted-time,
  ? clock_evidence: digest,
  outcome: "allow" / "deny",
  ? drawn: [+ { budget_term: digest, amount: uint .ge 1 }],
  ? holder_proof: digest,
}

; Class "authority_state_ack" (§9.12.3): issuer the PEP. A detection signal, never safety.
authority-state-ack = {
  pep: tstr .size (1..255),
  event: { exercise: digest } / { event: tstr .size (1..255) },
  applied_at: trusted-time,
  ? clock_evidence: digest,
  basis: uint,
  scope: [+ "cache" / "decision" / "session" / "token"],
}

; Class "party_key_state" (§10.1.5): the controller-signed key-event state. `designated` names,
; per Claim class, the issuers the Party designated (§9.13.1).
party-key-state = {
  sequence: uint,
  keys: [+ digest],
  ? designated: { + ident => [+ party-ref] },
}

; Class "party_recovered": the digests of the key-state bodies before and after.
party-recovered = { previous: digest, next: digest }

; Classes "identity_binding_<kind>", kind person, organization, workload, agent or
; legal_representative: the digest of the evidence of the external identity.
identity-binding = { evidence: digest }

; ---------------------------------------------------------------- unsigned Claims (§9.13 rule 2, OP-142)

; A Claim carried over an authenticated channel without a signature: attributable to the
; channel's peer, never meeting an assurance floor that asks for a signature. A PEP fact has
; channel "pep", the SHA-256 thumbprint of the PEP's client certificate (x5t#S256); only a
; `predicate-input` Acceptance admits it (§5.10, P37). ClaimID: the first 16 bytes of the
; digest of these bytes under "access/claim/v1".
unsigned-claim = {
  statement: claim-statement,
  channel: { pep: bstr .size 32 } / { scim: bstr .size 32 },
}

; ---------------------------------------------------------------- Token Status List (OP-150 m.3 (a), (s))

; The `status` claim of a referenced token: the projection's index in one list (IETF Token
; Status List). One bit per index: 0 valid, 1 invalid.
status-ref = { status_list: { idx: uint, uri: tstr .size (1..2048) } }

; `lst` is the ZLIB (RFC 1950) compressed byte array; index i is bit (i mod 8) of byte (i div 8),
; least significant first.
status-list = { bits: 1, lst: bstr, ? aggregation_uri: tstr }

; Payload of a COSE_Sign1 signed by an operational key with usage "status-list", content type
; "application/statuslist+cwt". Key 2 is the list's uri, 6 `iat` in seconds, 4 `exp`, 65534
; `ttl`, 65533 the list. `iat` and `as_of` are the recorded_at and position of the canonical
; state the list reflects, not the publication time (T24, SI-7).
status-list-cwt = {
  2 => tstr,
  6 => uint,
  ? 4 => uint,
  ? 65534 => uint,
  65533 => status-list,
  "as_of" => uint,
}
