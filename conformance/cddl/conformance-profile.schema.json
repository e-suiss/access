{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:conformance-profile:1",
  "title": "Access conformance profile (OP-157 m.3 (s), §9.1 L3, P2)",
  "description": "What an implementation of one role must pass: vector tracks, PEP cases and CDDL contracts, each of which must exist in this repository. `access-pep-conformance --profile <name>` runs it. Passing a profile is conformance, not endorsement. The CDDL twin is conformance-profile.cddl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "profile",
    "title",
    "vectors",
    "pep_cases",
    "cddl"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "profile": {
      "enum": [
        "provider",
        "decision-pep",
        "offline-verifier",
        "approval-surface",
        "claim-issuer",
        "schema-publisher",
        "coordinator",
        "event-receiver"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "shared_with": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      }
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,62}/[0-9]{1,3}$"
      }
    },
    "pep_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
      }
    },
    "cddl": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}\\.cddl$"
      }
    },
    "metadata_signature": {
      "type": "boolean"
    }
  }
}
