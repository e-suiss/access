; In-notification approval answer, version 1 (RFC 8610; OP-157 m.3 (m), m.17, §13.7.3, SEC26).
; Deterministic CBOR (RFC 8949 §4.2.1). Only for CT1 and only where the realm turned on
; `idp.realm.approval_inline`. The `approval_inline` Relay body carries the whole canonical
; render to the registered approver device; the approver SDK renders again with the Kernel,
; compares `render_digest`, and signs this map with its device key (ES256 over its dCBOR bytes).
; The names this file does not define are those of kernel.cddl.

approval-inline-answer = {
  invite: bstr .size 32,            ; the invite id from the body; single use
  decision: "approve" / "deny",
  ? aas: approval-act-statement,    ; required to approve; surface.profile "suiss-approver-sdk"
  render_digest: digest,            ; what the device rendered
  device_key: bstr .size 32,        ; JWK thumbprint (RFC 7638) of the signing device key
}

; The JSON body of `POST /v1/approve/inline`. A device key's signature is never a contribution
; by itself (§10.2, §10.3.1): an approval carries the WebAuthn assertion the app's platform
; passkey API returned for the approver's registered passkey in the realm, whose challenge is
; H(AAS) of `aas` and whose RP ID is the realm's (verifier name binding). Access verifies it as
; it verifies a sign-in: user presence always, user verification when an open term asks for it.
; Without it an approval is refused with `approval-inline-assertion-required`.

approval-inline-request = {
  answer: b64url,                   ; the dCBOR bytes of approval-inline-answer
  signature: b64url,                ; ES256 raw r || s by the device key
  ? assertion: approval-inline-assertion,
}

approval-inline-assertion = {
  credential_id: b64url,            ; rawId
  authenticator_data: b64url,       ; response.authenticatorData
  client_data_json: b64url,         ; response.clientDataJSON, type "webauthn.get"
  signature: b64url,                ; response.signature
  ? user_handle: b64url,            ; response.userHandle, when returned
}

b64url = tstr .regexp "[A-Za-z0-9_-]*"
