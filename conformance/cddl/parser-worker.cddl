; Access parser worker protocol, version 1 (RFC 8610; OP-155 m.3 (c), m.6 (b), (c), (d), (h);
; MD-1, MD-18, U43). The shapes are those of `crates/edge-core/src/ipc.rs`.
;
; `access-parser-worker` is the only process that parses XML and DER. Its workers run under the
; ParserWorker sandbox profile (no network syscalls, no keys, no file system) and are forked by
; a supervisor under its own ParserSupervisor profile. A gateway talks to the supervisor over a
; Unix domain socket; on Linux every reply byte carries the worker's own pid in
; SCM_CREDENTIALS, and callers are checked by peer uid.
;
; One request, then one reply. Each is two parts, both prefixed with a big-endian u32 length
; that is checked before anything is allocated:
;   1. a header: one deterministic CBOR map (RFC 8949 §4.2.1), at most 4 KiB, described below;
;   2. a segment: raw bytes, at most 1 MiB; the untrusted document in a request, the checked
;      (for xml.inflate, inflated) document in an `ok` reply, empty otherwise.
; Nothing may follow the segment. A header with an unknown member is malformed.
;
; Limits the worker enforces: XML DOCTYPE refused, only the 5 predefined entities, depth ≤ 64,
; ≤ 50 000 elements, 1 MB inflated, expansion ratio ≤ 100; DER ≤ 8 KiB with depth ≤ 32. Each
; request has 2 s of CPU, 5 s of wall clock and RLIMIT_AS 256 MiB. A worker is replaced after
; every reply that is not a clean `ok` (refusals included) and after 1000 requests. A crash, an overrun or an answer
; outside the protocol ends only that worker; the caller sees `worker-failed` (U43).

parser-request-header = {
  op: parser-op,
}

; `test.abort` makes the worker abort as a memory-corruption crash would; it exists only in a
; debug build (U43 test hook) and a release worker refuses it with `op-refused`.
parser-op = "xml.check" / "xml.inflate" / "der.check" / "test.abort"

parser-reply-header = parser-ok / parser-refused / parser-worker-failed

; Accepted; the segment is the checked document.
parser-ok = {
  status: "ok",
  elements: uint,                       ; elements read
  depth: uint,                          ; deepest nesting
  root: tstr,                           ; local name of the XML root element; empty for DER
}

; Refused by a limit or as malformed; the worker is recycled. Nothing of the input is echoed.
parser-refused = {
  status: "refused",
  code: parser-refusal,
}

parser-worker-failed = {
  status: "worker-failed",
}

parser-refusal = "op-refused" / "frame-malformed" / "deflate-malformed" /
  "xml-too-large" / "xml-encoding" / "xml-version" / "xml-malformed" / "xml-doctype" /
  "xml-entity" / "xml-processing-instruction" / "xml-depth" / "xml-elements" /
  "xml-ratio" / "xml-multiple-roots" / "xml-unclosed" / "xml-content-outside-root" /
  "der-too-large" / "der-depth" / "der-malformed"
