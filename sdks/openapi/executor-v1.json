{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "RFC 9457 problem details."
      }
    },
    "schemas": {
      "Job": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "description": "Whether an executor_control Claim confirms the pause or stop (U5).",
            "type": "boolean"
          },
          "exercise": {
            "description": "The ExerciseID the job runs.",
            "type": "string"
          },
          "handoff_until_ms": {
            "description": "When a job waiting for a person stops if nobody answered; silence is not approval.",
            "type": "integer"
          },
          "job": {
            "type": "string"
          },
          "kind": {
            "description": "The registered executor's kind; every kind follows the same rules (E57 (1)).",
            "enum": [
              "cloud",
              "customer",
              "local"
            ],
            "type": "string"
          },
          "reason": {
            "description": "Why it stopped or waits: person, decision, horizon, envelope, silence, cancel, release, report, continuation, unknown, blocked or approval.",
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "paused",
              "stopped",
              "unknown",
              "completed"
            ],
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array"
          }
        },
        "required": [
          "job",
          "exercise",
          "kind",
          "state",
          "confirmed",
          "steps"
        ],
        "type": "object"
      },
      "Outcome": {
        "description": "What the executor reports an effect came to (E64); `done` names at least one evidence kind.",
        "enum": [
          "done",
          "not-done",
          "unknown"
        ],
        "type": "string"
      },
      "Problem": {
        "description": "RFC 9457 problem details.",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "Resume": {
        "additionalProperties": false,
        "properties": {
          "continuations": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "continuations"
        ],
        "type": "object"
      },
      "StartJob": {
        "additionalProperties": false,
        "properties": {
          "ais": {
            "description": "The actor Instance's commit statement naming this executor as PEP, base64url; the executor forwards it and is never the actor.",
            "type": "string"
          },
          "connection": {
            "description": "The vault connection the Exercise's token is released from.",
            "type": "string"
          },
          "continuations": {
            "description": "The actor's continue statements for the checkpoints ahead, base64url; a checkpoint without one pauses the job.",
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "intent": {
            "description": "The intent envelope, canonical bytes, base64url.",
            "type": "string"
          },
          "realm": {
            "description": "The realm whose token vault holds the connection.",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepSpec"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "realm",
          "connection",
          "intent",
          "ais",
          "steps"
        ],
        "type": "object"
      },
      "Step": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "description": "The ClaimID of the step's effect_attestation.",
            "type": "string"
          },
          "commit_at_ms": {
            "description": "When an irreversible step's delayed commit sends it, Unix milliseconds; it can be cancelled until then.",
            "type": "integer"
          },
          "evidence": {
            "items": {
              "enum": [
                "upstream-confirmation",
                "independent-recheck",
                "browser-observation"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "idempotency_key": {
            "description": "H(ExerciseID ‖ StepRef), forwarded upstream (E62 (2)).",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "report_refused": {
            "description": "Why Claim Ingest refused the attestation; the job then stops.",
            "type": "string"
          },
          "step": {
            "description": "The StepRef, a digest.",
            "type": "string"
          }
        },
        "required": [
          "step",
          "name",
          "idempotency_key"
        ],
        "type": "object"
      },
      "StepPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "StepSpec": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "`namespace/name`; the Exercise's action.",
            "type": "string"
          },
          "call": {
            "oneOf": [
              {
                "properties": {
                  "body": {},
                  "driver": {
                    "const": "http"
                  },
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ],
                    "type": "string"
                  },
                  "url": {
                    "description": "https only.",
                    "type": "string"
                  }
                },
                "required": [
                  "driver",
                  "method",
                  "url"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "arguments": {},
                  "driver": {
                    "const": "mcp"
                  },
                  "server": {
                    "description": "The MCP server's https endpoint.",
                    "type": "string"
                  },
                  "tool": {
                    "type": "string"
                  }
                },
                "required": [
                  "driver",
                  "server",
                  "tool"
                ],
                "type": "object"
              }
            ]
          },
          "idempotent": {
            "description": "Whether the upstream honours the idempotency key; only then is a request whose answer a crash lost sent again, once, with the same key (TI-6).",
            "type": "boolean"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "resource": {
            "description": "`namespace:segment/segment`; one of the Exercise's resources.",
            "type": "string"
          },
          "reversibility": {
            "enum": [
              "reversible",
              "compensable",
              "irreversible"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "action",
          "resource",
          "reversibility",
          "call"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Jobs of a registered executor (B21, AG-40): each runs one allowed Exercise of an agent Instance durably and reports its effects as Claims. The executor decides nothing. Problem codes: executor-malformed, executor-ais, executor-intent, executor-nonce, executor-steps, executor-step, executor-continuation (400); executor-not-allowed (403); executor-unknown-job (404); executor-job-ended, executor-not-paused, executor-unknown-step, executor-step-sent, executor-stale (409); executor-unavailable (503).",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Access Executor API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/executor/v1/jobs": {
      "post": {
        "operationId": "startJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartJob"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Starts a job for one allowed Exercise of the calling agent Instance; the executor is an Instance of its operator Party and never decides (E62, OP-154 m.3 (u)).",
        "x-suiss-served": true
      }
    },
    "/executor/v1/jobs/{job}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "One job: its Exercise, its state (running, paused, stopped, unknown, completed), whether a pause or stop is confirmed, and its steps.",
        "x-suiss-served": true
      }
    },
    "/executor/v1/jobs/{job}/pause": {
      "post": {
        "operationId": "pauseJob",
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Pauses the job at its next step; the pause counts once an executor_control Claim confirms it (U5).",
        "x-suiss-served": true
      }
    },
    "/executor/v1/jobs/{job}/resume": {
      "post": {
        "operationId": "resumeJob",
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Resume"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Resumes a paused job with the actor's new continue statements; going on is a new Access decision, never the old one (E63 (2)).",
        "x-suiss-served": true
      }
    },
    "/executor/v1/jobs/{job}/steps": {
      "get": {
        "operationId": "listJobSteps",
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepPage"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The job's steps: each with its StepRef, idempotency key and reported outcome; a step whose result could not be verified is unknown and is never retried on its own (E62 (3)).",
        "x-suiss-served": true
      }
    },
    "/executor/v1/jobs/{job}/steps/{step}/cancel": {
      "post": {
        "operationId": "cancelStep",
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "step",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Cancels an irreversible step inside its delayed-commit window (15 s by default), and the job stops; silence is not approval (E47 (2)).",
        "x-suiss-served": true
      }
    },
    "/executor/v1/jobs/{job}/stop": {
      "post": {
        "operationId": "stopJob",
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Stops the job; no further effect once the executor confirms it with an executor_control Claim (U5).",
        "x-suiss-served": true
      }
    }
  }
}
