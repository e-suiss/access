{
  "version": 1,
  "flow": "lgf_example",
  "step": "profile",
  "action": "/v1/login/flows/lgf_example",
  "requirements": [
    {
      "requirement": "identifier",
      "state": "satisfied"
    },
    {
      "requirement": "first_factor",
      "state": "satisfied"
    },
    {
      "requirement": "second_factor",
      "state": "satisfied"
    },
    {
      "requirement": "profile",
      "state": "missing"
    }
  ],
  "nodes": [
    {
      "type": "choice",
      "name": "national_id_scheme",
      "method": "profile",
      "label": {
        "id": "label.national_id_scheme",
        "text": "Country of your identity number"
      },
      "options": [
        {
          "value": "tr-tckn",
          "label": {
            "id": "label.national_id_tr_tckn",
            "text": "Turkish identity number (T.C. Kimlik No)"
          }
        },
        {
          "value": "de-steuer-id",
          "label": {
            "id": "label.national_id_de_steuer_id",
            "text": "Tax identification number (Steuer-ID)"
          }
        },
        {
          "value": "generic:6-12:digits",
          "label": {
            "id": "label.national_id_other",
            "text": "Another country"
          }
        }
      ]
    },
    {
      "type": "input",
      "name": "national_id",
      "method": "profile",
      "kind": "text",
      "autocomplete": "off",
      "required": true,
      "max_length": 32,
      "label": {
        "id": "label.national_id",
        "text": "National identity number"
      }
    },
    {
      "type": "submit",
      "method": "profile",
      "label": {
        "id": "action.continue",
        "text": "Continue"
      }
    },
    {
      "type": "submit",
      "method": "restart",
      "label": {
        "id": "action.restart",
        "text": "Use a different account"
      }
    }
  ],
  "messages": [
    {
      "id": "profile.complete",
      "text": "Finish setting up your account to continue.",
      "severity": "info"
    }
  ]
}
