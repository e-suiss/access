{
  "components": {
    "responses": {
      "NotYetServed": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The route is declared and not served yet (OP-155 m.4)."
      },
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An RFC 9457 problem."
      }
    },
    "schemas": {
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The OID4VP verifier service (HAIP: SD-JWT VC and mdoc, ES256, direct_post.jwt). A verified presentation reaches Claim Ingest as a Claim signed with the verifier's Instance key and counts only where an Acceptance names the verifier. A planned route answers 501 not-yet-served.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Access VC verifier API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/vc-verifier/v1/presentations": {
      "post": {
        "operationId": "createPresentationRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Starts a presentation request for a domain and subject Party (Authorization: Bearer caller key): the DCQL query naming exactly the claims asked, and same-device (with return_uri) or cross-device mode; answers the request URI and the openid4vp:// link the wallet opens, as a link or a QR code (HAIP)."
      }
    },
    "/vc-verifier/v1/presentations/{request}": {
      "get": {
        "operationId": "getPresentationResult",
        "parameters": [
          {
            "in": "path",
            "name": "request",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The request's outcome for the caller that started it (Authorization: Bearer; same-device needs response_code): verified with the Claims sent to Claim Ingest and their dispositions, refused with a reason, pending or expired; never the disclosed values."
      }
    },
    "/vc-verifier/v1/requests/{request}": {
      "get": {
        "operationId": "getRequestObject",
        "parameters": [
          {
            "in": "path",
            "name": "request",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The signed request object the wallet fetches by request_uri (application/oauth-authz-req+jwt)."
      }
    },
    "/vc-verifier/v1/responses/{request}": {
      "post": {
        "operationId": "postWalletResponse",
        "parameters": [
          {
            "in": "path",
            "name": "request",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The wallet's encrypted direct_post.jwt response (form field response): SD-JWT VC or mdoc, ES256 only, disclosing nothing beyond the DCQL query; a same-device wallet gets a redirect_uri carrying a one-time response_code."
      }
    },
    "/vc-verifier/v1/trusted-lists": {
      "get": {
        "operationId": "getTrustedListState",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The trusted lists the verifier loaded (EU LoTL and TLs): sequence number, next update and whether the XAdES signature verified in the parser worker."
      }
    }
  }
}
