{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:caep:credential-change:1",
  "title": "CAEP credential-change (OpenID CAEP 1.0)",
  "description": "A password, passkey or TOTP of the subject was added, replaced or removed.",
  "type": "object",
  "required": [
    "event_timestamp",
    "credential_type",
    "change_type"
  ],
  "additionalProperties": false,
  "properties": {
    "event_timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "NumericDate, seconds."
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "password",
        "app",
        "fido2-roaming",
        "x509"
      ]
    },
    "change_type": {
      "type": "string",
      "enum": [
        "create",
        "revoke",
        "update"
      ]
    }
  }
}
