{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:event:api_client.disabled:1",
  "title": "An API client was retired: idp.client.retire (OP-149 m.4)",
  "description": "The member of the SET `events` claim, and of the CloudEvent `data.events`, under `urn:suiss:access:event:api_client.disabled`.",
  "type": "object",
  "required": [
    "tenant",
    "realm",
    "client_id",
    "exercise",
    "at",
    "access_position"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant": {
      "$ref": "#/$defs/tenant"
    },
    "realm": {
      "$ref": "#/$defs/uuid"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "exercise": {
      "$ref": "#/$defs/b64url32"
    },
    "platform_product": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "The product name the operator gave this platform client (OP-149 m.4, OP-150 m.3 (m)): any registered product, first or third party."
    },
    "at": {
      "$ref": "#/$defs/ms"
    },
    "access_position": {
      "$ref": "#/$defs/access_position"
    }
  },
  "$defs": {
    "b64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "b64url16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time, milliseconds."
    },
    "source": {
      "description": "The Exercise whose decision recorded the event, or the Claim whose record admitted it.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "exercise"
          ],
          "additionalProperties": false,
          "properties": {
            "exercise": {
              "$ref": "#/$defs/b64url32"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "claim"
          ],
          "additionalProperties": false,
          "properties": {
            "claim": {
              "$ref": "#/$defs/b64url16"
            }
          }
        }
      ]
    },
    "tenant": {
      "type": "string",
      "pattern": "^tnt_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "A tenant's opaque external id, the same one the tenant snapshot uses (OP-149 m.15 (i))."
    },
    "access_position": {
      "type": "object",
      "description": "The event's monotone version field (OP-22): it only grows within its source, the domain for an authority event and the issuer for an identity event. A receiver that has applied a later or equal position re-queries instead of applying this event.",
      "required": [
        "pos",
        "idx"
      ],
      "additionalProperties": false,
      "properties": {
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "idx": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
