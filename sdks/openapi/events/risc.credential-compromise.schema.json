{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:risc:credential-compromise:1",
  "title": "RISC credential-compromise (OpenID RISC 1.0)",
  "description": "A credential was found compromised; with sub_id format uri, the realm's own signing key (CR-27).",
  "type": "object",
  "required": [
    "event_timestamp",
    "credential_type"
  ],
  "additionalProperties": false,
  "properties": {
    "event_timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "NumericDate, seconds."
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "password",
        "app",
        "fido2-roaming",
        "x509"
      ]
    }
  }
}
