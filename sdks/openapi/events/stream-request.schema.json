{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:stream-request:1",
  "title": "Stream creation request (SSF 1.0 §8.1.1.1); one channel per stream (OP-149 m.7)",
  "type": "object",
  "required": [
    "delivery",
    "aud",
    "events_requested"
  ],
  "additionalProperties": false,
  "properties": {
    "delivery": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "urn:ietf:rfc:8935",
            "urn:ietf:rfc:8936",
            "urn:suiss:access:delivery:webhook"
          ]
        },
        "endpoint_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "events_requested": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "oneOf": [
          {
            "pattern": "^urn:suiss:access:event:[a-z][a-z0-9_.-]*$"
          },
          {
            "pattern": "^https://schemas[.]openid[.]net/secevent/caep/event-type/[a-z][a-z-]*$"
          },
          {
            "pattern": "^https://schemas[.]openid[.]net/secevent/risc/event-type/[a-z][a-z-]*$"
          }
        ]
      }
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "profile": {
      "type": "string",
      "enum": [
        "access",
        "caep",
        "both"
      ],
      "description": "Whether Access events with a CAEP counterpart go with it (`both`, the default), instead of it (`caep`) or alone (`access`) (§9.16)."
    },
    "alg": {
      "type": "string",
      "enum": [
        "ES256",
        "RS256"
      ],
      "description": "The SET signing algorithm (TN-40). ES256 by default; RS256 is answered with problem `unsupported_alg` until the realm can hold an RSA key."
    }
  }
}
