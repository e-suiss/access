{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:stream-request:1",
  "title": "Stream creation request (SSF 1.0 §8.1.1.1); one channel per stream (OP-149 m.7)",
  "type": "object",
  "required": [
    "delivery",
    "aud",
    "events_requested"
  ],
  "additionalProperties": false,
  "properties": {
    "delivery": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "urn:ietf:rfc:8935",
            "urn:ietf:rfc:8936",
            "urn:suiss:access:delivery:webhook"
          ]
        },
        "endpoint_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "events_requested": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^urn:suiss:access:event:[a-z][a-z0-9_.-]*$"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 512
    }
  }
}
