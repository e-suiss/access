{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:event:credential.changed:1",
  "title": "A password, passkey or second factor of an account was added, replaced or removed (OP-151 m.3 (i))",
  "description": "The member of the SET `events` claim, and of the CloudEvent `data.events`, under `urn:suiss:access:event:credential.changed`. A notification, never an authority source: losing or delaying it changes no decision (INV-24).",
  "type": "object",
  "required": [
    "realm",
    "account",
    "credential",
    "change",
    "at"
  ],
  "additionalProperties": false,
  "properties": {
    "realm": {
      "$ref": "#/$defs/uuid"
    },
    "account": {
      "$ref": "#/$defs/account"
    },
    "at": {
      "$ref": "#/$defs/ms"
    },
    "credential": {
      "type": "string",
      "enum": [
        "password",
        "webauthn",
        "totp",
        "recovery_code",
        "other"
      ]
    },
    "change": {
      "type": "string",
      "enum": [
        "added",
        "replaced",
        "removed"
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time, milliseconds."
    },
    "account": {
      "type": "string",
      "pattern": "^usr_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "The account's opaque external id (OP-137): pseudonymous, never an identifier or a name."
    }
  }
}
