{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:schema:caep:risk-level-change:1",
  "title": "CAEP risk-level-change (OpenID CAEP 1.0)",
  "description": "The SL2 risk level of the account moved (§12.2.4); risk only narrows.",
  "type": "object",
  "required": [
    "event_timestamp",
    "principal",
    "current_level"
  ],
  "additionalProperties": false,
  "properties": {
    "event_timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "NumericDate, seconds."
    },
    "principal": {
      "const": "USER"
    },
    "current_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "previous_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    }
  }
}
