{
  "openapi": "3.1.1",
  "info": {
    "title": "Access Frontend API: login node contract",
    "version": "1",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "paths": {
    "/v1/login/flows": {
      "post": {
        "operationId": "createLoginFlow",
        "summary": "Start a login flow; answers the identifier step (TN-96).",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The identifier step.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            }
          },
          "429": {
            "description": "Too many flows from this network.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable (OP-36).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/login/flows/{flow}": {
      "parameters": [
        {
          "name": "flow",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/FlowId"
          }
        }
      ],
      "get": {
        "operationId": "getLoginFlow",
        "summary": "The flow's current step.",
        "responses": {
          "200": {
            "description": "The current step.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            }
          },
          "410": {
            "description": "The flow expired or was used up; start a new one.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitLoginFlow",
        "summary": "Submit one method of the current step (TN-106: fields the step did not offer are refused).",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The next step, or the same step with messages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            }
          },
          "400": {
            "description": "The submission does not match the step.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The same step with the one neutral refusal, identical for every account (CR-40).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            }
          },
          "410": {
            "description": "The flow expired or was used up; start a new one.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "The same step with `login.throttled`; the same for every identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable (OP-36).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginUi": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "flow",
          "step",
          "action",
          "requirements",
          "nodes",
          "messages"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "flow": {
            "$ref": "#/components/schemas/FlowId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "login",
              "registration",
              "recovery",
              "settings",
              "consent",
              "invitation",
              "link"
            ]
          },
          "step": {
            "type": "string",
            "enum": [
              "identifier",
              "authenticate",
              "second_factor",
              "complete"
            ]
          },
          "action": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequirementStatus"
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "redirect_to": {
            "type": "string"
          }
        }
      },
      "FlowId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      "RequirementStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "state"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "enum": [
              "identifier",
              "first_factor",
              "second_factor"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "missing",
              "satisfied"
            ]
          }
        }
      },
      "Node": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "method",
              "kind",
              "autocomplete",
              "required",
              "max_length",
              "label"
            ],
            "properties": {
              "type": {
                "const": "input"
              },
              "name": {
                "$ref": "#/components/schemas/FieldName"
              },
              "method": {
                "$ref": "#/components/schemas/Method"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "password",
                  "code",
                  "hidden"
                ]
              },
              "autocomplete": {
                "type": "string",
                "enum": [
                  "username webauthn",
                  "username",
                  "current-password",
                  "one-time-code",
                  "off",
                  "new-password",
                  "email",
                  "name"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "max_length": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "value": {
                "type": "string"
              },
              "read_only": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "method",
              "label"
            ],
            "properties": {
              "type": {
                "const": "submit"
              },
              "method": {
                "$ref": "#/components/schemas/Method"
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "label",
              "options"
            ],
            "properties": {
              "type": {
                "const": "passkey_get"
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "options": {
                "$ref": "#/components/schemas/PasskeyOptions"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "field",
              "options"
            ],
            "properties": {
              "type": {
                "const": "passkey_autofill"
              },
              "field": {
                "$ref": "#/components/schemas/FieldName"
              },
              "options": {
                "$ref": "#/components/schemas/PasskeyOptions"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "mediation",
              "label",
              "options"
            ],
            "properties": {
              "type": {
                "const": "passkey_create"
              },
              "mediation": {
                "type": "string",
                "enum": [
                  "explicit",
                  "conditional"
                ]
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "options": {
                "$ref": "#/components/schemas/PasskeyOptions"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "signal"
            ],
            "properties": {
              "type": {
                "const": "passkey_signal"
              },
              "signal": {
                "$ref": "#/components/schemas/PasskeySignal"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "label",
              "checked"
            ],
            "properties": {
              "type": {
                "const": "option"
              },
              "name": {
                "$ref": "#/components/schemas/FieldName"
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "checked": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "provider",
              "label",
              "href"
            ],
            "properties": {
              "type": {
                "const": "provider"
              },
              "provider": {
                "type": "string"
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "href": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        ]
      },
      "FieldName": {
        "type": "string",
        "enum": [
          "identifier",
          "password",
          "totp_code",
          "recovery_code",
          "passkey_credential",
          "email_code",
          "email",
          "new_password",
          "display_name",
          "acknowledged",
          "invitation_code",
          "link_code",
          "bot_token",
          "keep_signed_in",
          "remember_device"
        ]
      },
      "Method": {
        "type": "string",
        "enum": [
          "identifier",
          "password",
          "passkey",
          "totp",
          "recovery_code",
          "passkey_register",
          "skip",
          "restart",
          "email_code",
          "magic_link",
          "register",
          "recover",
          "new_password",
          "share",
          "dont_share",
          "accept_invitation",
          "link",
          "acknowledge"
        ]
      },
      "TextId": {
        "type": "string",
        "enum": [
          "login.failed",
          "login.throttled",
          "login.unavailable",
          "flow.expired",
          "second_factor.failed",
          "passkey.not_registered",
          "label.identifier",
          "label.password",
          "label.totp_code",
          "label.recovery_code",
          "action.continue",
          "action.sign_in",
          "action.passkey",
          "action.passkey_create",
          "action.verify",
          "action.recovery_code",
          "action.skip",
          "action.restart",
          "label.email_code",
          "action.email_code",
          "action.magic_link",
          "email.sent",
          "registration.title",
          "label.email",
          "label.new_password",
          "label.display_name",
          "action.create_account",
          "registration.code_sent",
          "registration.failed",
          "action.have_account",
          "registration.complete",
          "recovery.title",
          "action.recovery_start",
          "recovery.requested",
          "recovery.cooling",
          "recovery.denied",
          "recovery.complete",
          "recovery.locked",
          "recovery_codes.title",
          "recovery_codes.save",
          "action.codes_saved",
          "label.link_code",
          "settings.title",
          "settings.sign_in_methods",
          "settings.sign_ins",
          "settings.tied_to_device",
          "action.end_sign_in",
          "action.sign_out",
          "settings.connected_apps",
          "action.stop_sharing",
          "settings.linked_sign_ins",
          "notice.email_changed",
          "notice.new_method",
          "action.secure_account",
          "signed_out.password_changed",
          "signed_out.device_mismatch",
          "signed_out.admin_ended",
          "signed_out.recovery",
          "signed_out.expired",
          "signed_out.delegations_remain",
          "account.sign_in_turned_off",
          "account.deletion_scheduled",
          "account.deleted",
          "account.export_ready",
          "account.email_confirmed",
          "consent.title",
          "consent.claims",
          "action.share",
          "action.dont_share",
          "delegation.check_note",
          "delegation.created",
          "invitation.title",
          "action.accept_invitation",
          "invitation.expired",
          "label.invitation_code",
          "link.title",
          "link.combine_warning",
          "error.reference",
          "error.app_owner",
          "error.upstream_owner",
          "error.access_owner",
          "step_up.required",
          "claim.issuer_says",
          "label.keep_signed_in",
          "label.remember_device",
          "action.continue_with",
          "consent.agent_title",
          "consent.client_says",
          "consent.resource",
          "consent.redirect_host",
          "consent.loopback",
          "consent.new_app",
          "action.approve_access",
          "action.decline_access",
          "device_code.title",
          "label.device_code",
          "device_code.invalid",
          "device_code.request",
          "device_code.approved",
          "device_code.denied",
          "consent.visual_changed",
          "ciba.title",
          "ciba.binding_message",
          "ciba.approved",
          "ciba.denied",
          "ciba.expired",
          "device_code.request_prefix",
          "upstream.unreachable",
          "upstream.subject_conflict",
          "hrd.title",
          "hrd.confirm",
          "action.continue_to_organization",
          "action.use_another_way",
          "certificate.title",
          "certificate.prompt",
          "certificate.refused",
          "certificate.status_unknown",
          "action.use_certificate",
          "sso_setup.title",
          "sso_setup.choose_provider",
          "sso_setup.configure",
          "sso_setup.test",
          "sso_setup.done",
          "sso_setup.link_expired",
          "sso_setup.enforce_preview",
          "sso_setup.enforce_invites",
          "vc.present_title",
          "vc.present_request",
          "action.open_wallet",
          "vc.present_failed",
          "consent.trust_mark"
        ]
      },
      "Text": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TextId"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "severity"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TextId"
          },
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "error"
            ]
          },
          "retry_after_s": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PasskeyOptions": {
        "type": "object",
        "description": "WebAuthn options in their JSON form (parseRequestOptionsFromJSON / parseCreationOptionsFromJSON)."
      },
      "PasskeySignal": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "rp_id",
              "credential_id"
            ],
            "properties": {
              "kind": {
                "const": "unknown_credential"
              },
              "rp_id": {
                "type": "string"
              },
              "credential_id": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "rp_id",
              "user_id",
              "all_accepted_credential_ids"
            ],
            "properties": {
              "kind": {
                "const": "all_accepted_credentials"
              },
              "rp_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              },
              "all_accepted_credential_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "rp_id",
              "user_id",
              "name",
              "display_name"
            ],
            "properties": {
              "kind": {
                "const": "current_user_details"
              },
              "rp_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              }
            }
          }
        ]
      },
      "LoginSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "$ref": "#/components/schemas/Method"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/components/schemas/FieldName"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
