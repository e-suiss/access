{
  "components": {
    "schemas": {
      "FieldName": {
        "enum": [
          "identifier",
          "password",
          "totp_code",
          "recovery_code",
          "passkey_credential",
          "email_code"
        ],
        "type": "string"
      },
      "FlowId": {
        "pattern": "^[A-Za-z0-9_-]{1,128}$",
        "type": "string"
      },
      "LoginSubmission": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/FieldName"
            },
            "type": "object"
          },
          "method": {
            "$ref": "#/components/schemas/Method"
          }
        },
        "required": [
          "method"
        ],
        "type": "object"
      },
      "LoginUi": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "flow": {
            "$ref": "#/components/schemas/FlowId"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array"
          },
          "redirect_to": {
            "type": "string"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/RequirementStatus"
            },
            "type": "array"
          },
          "step": {
            "enum": [
              "identifier",
              "authenticate",
              "second_factor",
              "complete"
            ],
            "type": "string"
          },
          "version": {
            "const": 1
          }
        },
        "required": [
          "version",
          "flow",
          "step",
          "action",
          "requirements",
          "nodes",
          "messages"
        ],
        "type": "object"
      },
      "Message": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TextId"
          },
          "retry_after_s": {
            "minimum": 0,
            "type": "integer"
          },
          "severity": {
            "enum": [
              "info",
              "error"
            ],
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "severity"
        ],
        "type": "object"
      },
      "Method": {
        "enum": [
          "identifier",
          "password",
          "passkey",
          "totp",
          "recovery_code",
          "passkey_register",
          "skip",
          "restart",
          "email_code",
          "magic_link"
        ],
        "type": "string"
      },
      "Node": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "autocomplete": {
                "enum": [
                  "username webauthn",
                  "username",
                  "current-password",
                  "one-time-code",
                  "off"
                ],
                "type": "string"
              },
              "kind": {
                "enum": [
                  "text",
                  "password",
                  "code"
                ],
                "type": "string"
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "max_length": {
                "minimum": 1,
                "type": "integer"
              },
              "method": {
                "$ref": "#/components/schemas/Method"
              },
              "name": {
                "$ref": "#/components/schemas/FieldName"
              },
              "read_only": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "const": "input"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "method",
              "kind",
              "autocomplete",
              "required",
              "max_length",
              "label"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "method": {
                "$ref": "#/components/schemas/Method"
              },
              "type": {
                "const": "submit"
              }
            },
            "required": [
              "type",
              "method",
              "label"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "options": {
                "$ref": "#/components/schemas/PasskeyOptions"
              },
              "type": {
                "const": "passkey_get"
              }
            },
            "required": [
              "type",
              "label",
              "options"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "field": {
                "$ref": "#/components/schemas/FieldName"
              },
              "options": {
                "$ref": "#/components/schemas/PasskeyOptions"
              },
              "type": {
                "const": "passkey_autofill"
              }
            },
            "required": [
              "type",
              "field",
              "options"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "mediation": {
                "enum": [
                  "explicit",
                  "conditional"
                ],
                "type": "string"
              },
              "options": {
                "$ref": "#/components/schemas/PasskeyOptions"
              },
              "type": {
                "const": "passkey_create"
              }
            },
            "required": [
              "type",
              "mediation",
              "label",
              "options"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "signal": {
                "$ref": "#/components/schemas/PasskeySignal"
              },
              "type": {
                "const": "passkey_signal"
              }
            },
            "required": [
              "type",
              "signal"
            ],
            "type": "object"
          }
        ]
      },
      "PasskeyOptions": {
        "description": "WebAuthn options in their JSON form (parseRequestOptionsFromJSON / parseCreationOptionsFromJSON).",
        "type": "object"
      },
      "PasskeySignal": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "credential_id": {
                "type": "string"
              },
              "kind": {
                "const": "unknown_credential"
              },
              "rp_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "rp_id",
              "credential_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "all_accepted_credential_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "kind": {
                "const": "all_accepted_credentials"
              },
              "rp_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "rp_id",
              "user_id",
              "all_accepted_credential_ids"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "display_name": {
                "type": "string"
              },
              "kind": {
                "const": "current_user_details"
              },
              "name": {
                "type": "string"
              },
              "rp_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "rp_id",
              "user_id",
              "name",
              "display_name"
            ],
            "type": "object"
          }
        ]
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "RequirementStatus": {
        "additionalProperties": false,
        "properties": {
          "requirement": {
            "enum": [
              "identifier",
              "first_factor",
              "second_factor"
            ],
            "type": "string"
          },
          "state": {
            "enum": [
              "missing",
              "satisfied"
            ],
            "type": "string"
          }
        },
        "required": [
          "requirement",
          "state"
        ],
        "type": "object"
      },
      "Text": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TextId"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "TextId": {
        "enum": [
          "login.failed",
          "login.throttled",
          "login.unavailable",
          "flow.expired",
          "second_factor.failed",
          "passkey.not_registered",
          "label.identifier",
          "label.password",
          "label.totp_code",
          "label.recovery_code",
          "action.continue",
          "action.sign_in",
          "action.passkey",
          "action.passkey_create",
          "action.verify",
          "action.recovery_code",
          "action.skip",
          "action.restart",
          "label.email_code",
          "action.email_code",
          "action.magic_link",
          "email.sent"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Access Frontend API: login node contract",
    "version": "1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/v1/login/flows": {
      "post": {
        "operationId": "createLoginFlow",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            },
            "description": "The identifier step."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many flows from this network."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Temporarily unavailable (OP-36)."
          }
        },
        "summary": "Start a login flow; answers the identifier step (TN-96)."
      }
    },
    "/v1/login/flows/{flow}": {
      "get": {
        "operationId": "getLoginFlow",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            },
            "description": "The current step."
          },
          "410": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The flow expired or was used up; start a new one."
          }
        },
        "summary": "The flow's current step."
      },
      "parameters": [
        {
          "in": "path",
          "name": "flow",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/FlowId"
          }
        }
      ],
      "post": {
        "operationId": "submitLoginFlow",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            },
            "description": "The next step, or the same step with messages."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The submission does not match the step."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            },
            "description": "The same step with the one neutral refusal, identical for every account (CR-40)."
          },
          "410": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The flow expired or was used up; start a new one."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUi"
                }
              }
            },
            "description": "The same step with `login.throttled`; the same for every identifier."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Temporarily unavailable (OP-36)."
          }
        },
        "summary": "Submit one method of the current step (TN-106: fields the step did not offer are refused)."
      }
    }
  }
}
