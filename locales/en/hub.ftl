# Access hub texts, en (OP-153 m.3 (s)). Keys: conformance/catalog/messages.toml.

remediation-route_to_coordinator = Someone who coordinates this needs to take it forward.
remediation-refresh_claim = A statement this relies on needs to be renewed.
remediation-self_authenticate = Confirm it's you to continue.
remediation-wait_until = This can go ahead after the time shown.
remediation-not_satisfiable_by_actor = You can't meet this yourself; someone with authority over it can.
remediation-new_request_required = Start a new request.
blocker-no_covering_authority = Not allowed: no authority covers this.
blocker-outside_instance_limits = Not allowed: outside this copy's limits.
blocker-restricted = Not allowed: a restriction applies.
blocker-budget_exhausted = Not allowed: no limit left.
blocker-ended = Not allowed: the authority has ended.
blocker-capacity_mismatch = Not allowed: this authority can't be used in this role.
blocker-source_not_accepted = Not allowed: the source isn't accepted here.
blocker-schema_not_accepted = Not allowed: this action isn't accepted here.
blocker-nonce_closed = This request was already decided.
blocker-foreign_status_unavailable = Not allowed: a partner's status can't be checked now.
