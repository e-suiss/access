      "required": [
        "recipient",
        "at",
        "method"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/recipient"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "enum": [
            "password",
            "passkey",
            "otp",
            "magic_link",
            "federated"
          ]
        },
        "recipient_valid_since": {
          "$ref": "#/$defs/recipient_valid_since"
        }
      }
    },
    "relay.message.account_status.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "status",
        "at"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/recipient"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "status": {
          "enum": [
            "staged",
            "pending_user_action",
            "active",
            "locked",
            "suspended",
            "deactivated",
            "tombstone",
            "purging"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "recipient_valid_since": {
          "$ref": "#/$defs/recipient_valid_since"
        }
      }
    },
    "recipient_valid_since": {
      "type": "string",
      "format": "date-time",
      "description": "Since when the recipient has owned the mailbox; Relay sends it as RFC 7293 Require-Recipient-Valid-Since. E-mail recipients only."
    },
