{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suiss:access:relay-message:v1",
  "title": "Access to Relay message, version 1",
  "description": "A CloudEvents 1.0 event in structured JSON mode (application/cloudevents+json) that Access posts to Relay for delivery to a person (E42, OP-146 m.4 (b)). `id` is a random UUID and the Idempotency-Key; Relay deduplicates by it. `data` is selected by `type`. `recipient` and the secret fields (`code`, `link`) are never logged by either side.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "accesstenant",
    "accessrealm",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "pattern": "^urn:suiss:access:realm:[0-9a-f-]{36}$"
    },
    "type": {
      "enum": [
        "relay.message.otp.v1",
        "relay.message.magic_link.v1",
        "relay.message.password_changed.v1",
        "relay.message.new_sign_in.v1",
        "relay.message.account_status.v1",
        "relay.message.recovery_requested.v1",
        "relay.message.recovery_cooling.v1",
        "relay.message.recovery_completed.v1",
        "relay.message.recovery_codes_regenerated.v1",
        "relay.message.second_factor_enabled.v1",
        "relay.message.new_method.v1",
        "relay.message.email_changed.v1",
        "relay.message.deletion_scheduled.v1",
        "relay.message.deletion_completed.v1",
        "relay.message.inactivity_notice.v1",
        "relay.message.signup_existing.v1",
        "relay.message.ownership_handover.v1",
        "relay.message.reset_intent.v1",
        "relay.message.export_ready.v1",
        "relay.message.invitation.v1"
      ]
    },
    "subject": {
      "type": "string",
      "description": "The subject's external id (OP-137), prefix usr_."
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "accesstenant": {
      "type": "string",
      "format": "uuid"
    },
    "accessrealm": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "relay.message.otp.v1"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/relay.message.otp.v1"
          }
        }
      }
    },
    {
