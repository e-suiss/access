  "$defs": {
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        }
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,33}[A-Za-z0-9]$"
    },
    "relay.message.otp.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "code",
        "purpose",
        "expires_at"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/recipient"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{4,12}$",
          "description": "Secret: the one-time code. Never logged."
        },
        "purpose": {
          "enum": [
            "sign_in",
            "verify_address",
            "recovery",
            "sign_up"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "recipient_valid_since": {
          "$ref": "#/$defs/recipient_valid_since"
        }
      }
    },
    "relay.message.magic_link.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "link",
        "expires_at"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/recipient"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "link": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://",
          "description": "Secret: the sign-in link. Never logged."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "recipient_valid_since": {
          "$ref": "#/$defs/recipient_valid_since"
        }
      }
    },
    "relay.message.password_changed.v1": {
