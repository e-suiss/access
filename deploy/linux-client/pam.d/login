# OP-156 m.3 (p): console sign-in through Access; the module answers AUTHINFO_UNAVAIL, never a
# success, when access-linuxd does not decide. The absolute path keeps it apart from
# Linux-PAM's own pam_access.so.
auth       required     /usr/lib/access/pam_access.so
account    include      common-account
session    include      common-session
session    optional     pam_mkhomedir.so skel=/etc/skel umask=0077
