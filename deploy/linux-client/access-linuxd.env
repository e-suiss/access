# OP-156 m.3 (p): the daemon's settings. Key material is read from the files named here only;
# the files belong to root with mode 0600.
ACCESS_LINUXD_ISSUER=https://acme.access.example
ACCESS_LINUXD_CLIENT_ID=linux-hosts
ACCESS_LINUXD_CA=/etc/access-linuxd/ca.pem
ACCESS_LINUXD_CERT=/etc/access-linuxd/host.pem
ACCESS_LINUXD_KEY=/etc/access-linuxd/host.key
ACCESS_LINUXD_SOCKET=/run/access-linuxd/socket
ACCESS_LINUXD_STATE=/var/lib/access-linuxd
