# OP-155 m.3 (o), Ek B 4988, §10.6.4, MD-1: the Kerberos/SPNEGO gateway, a separate image variant.
# It is the only image that carries libgssapi (C FFI); the main image never does. Built from the
# gateway's own workspace and lock file.

ARG RUST_IMAGE=rust@sha256:24e632c09342c20abf8312cf4f61430a911c01ed3a5e4c02b87292b1c39c5273
# trixie-slim, the release the Rust image builds on; distroless has no libkrb5
ARG RUNTIME_IMAGE=debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

FROM ${RUST_IMAGE} AS builder
WORKDIR /src
ENV RUSTUP_TOOLCHAIN=1.99.0 \
    CARGO_TERM_COLOR=never \
    RUSTFLAGS="--remap-path-prefix=/src=/access --remap-path-prefix=/usr/local/cargo=/cargo"
RUN apt-get update \
 && apt-get install -y --no-install-recommends libkrb5-dev libclang-dev pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && cargo install --locked cargo-auditable --version 0.7.6
COPY . .
# F-5, SA-23, §14.5
RUN cargo auditable build --release --locked --manifest-path bins/access-gw-kerberos/Cargo.toml \
 && scripts/checksec.sh bins/access-gw-kerberos/target/release/access-gw-kerberos

FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgssapi-krb5-2 libkrb5-3 \
 && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="access-gw-kerberos" \
      org.opencontainers.image.source="https://github.com/e-suiss/access" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=builder /src/bins/access-gw-kerberos/target/release/access-gw-kerberos /usr/local/bin/
# §14.5, RAUTHY-008
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/access-gw-kerberos"]
