# IDP-30 (2), OP-156 m.3 (m), OP-49: the proxy engines, each the official image pinned by digest.
# Envoy and Caddy are the bases of the -proxy-envoy and -proxy-caddy images and appear in their
# SBOM; Traefik and Nginx run only in the CI job proxy-engines and go into no image.
ENVOY_IMAGE=docker.io/envoyproxy/envoy@sha256:09ca6f2140a61ad8df11779a4a30d52b48433d444466328494f9188c9c35eded
ENVOY_VERSION=1.40.2
CADDY_IMAGE=docker.io/library/caddy@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee
CADDY_VERSION=2.11.9
TRAEFIK_IMAGE=docker.io/library/traefik@sha256:f4bb143d1135a579b630ed491e17ec50f6f7c9c6a30585ff3d385471d2a86f5a
TRAEFIK_VERSION=3.7.17
NGINX_IMAGE=docker.io/library/nginx@sha256:583b7f2fce1cdb8da5ad5c39ebd3c33b98b87d493190e548bdee1fa8c619c311
NGINX_VERSION=1.30.6
