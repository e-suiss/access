# IDP-30 (2), OP-156 m.3 (m), OP-49: the proxy engines, each the official image pinned by digest.
# Envoy and Caddy are the bases of the -proxy-envoy and -proxy-caddy images and appear in their
# SBOM; Traefik and Nginx run only in the CI job proxy-engines and go into no image. F-2: each
# linux/amd64 config blob was created at least 7 days before it was pinned (2026-11-10):
# envoy 2026-10-27, caddy 2026-10-21, traefik 2026-10-21, nginx 2026-09-22.
ENVOY_IMAGE=docker.io/envoyproxy/envoy@sha256:09ca6f2140a61ad8df11779a4a30d52b48433d444466328494f9188c9c35eded
ENVOY_VERSION=1.40.2
CADDY_IMAGE=docker.io/library/caddy@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
CADDY_VERSION=2.11.7
TRAEFIK_IMAGE=docker.io/library/traefik@sha256:1336e85aaed293bd63d005086e0dd013b04078b26aaeb1c18b26a2f928af7e65
TRAEFIK_VERSION=3.7.16
NGINX_IMAGE=docker.io/library/nginx@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
NGINX_VERSION=1.30.5
