{
  "uid": "access-signals",
  "title": "Access operation signals",
  "description": "The section 17.8.2 operation signals. No tenant, realm or domain breakdown: that comes from the analytics tables (OP-47).",
  "tags": [
    "access"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
